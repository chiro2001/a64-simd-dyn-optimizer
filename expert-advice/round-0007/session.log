    49	def parse_inst(line):
    50	    """Return (mnemonic, dst, reads) or None."""
    51	    m = re.match(r"\s*[0-9a-f]+:\s+[0-9a-f]{8}\s+([a-z0-9]+)\s*(.*)", line)
    52	    if not m:
