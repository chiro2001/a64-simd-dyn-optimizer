    84	static void dct8_oracle(const int16_t* src, int16_t* dst, intptr_t srcStride)
    85	{
    86	    const int shift_1st = 2 + 8 - 8;   // X265_DEPTH=8
    87	    const int shift_2nd = 9;
    88	    int16_t coef[8 * 8];
    89	    int16_t block[8 * 8];
    90	
    91	    for (int i = 0; i < 8; i++)
    92	        memcpy(&block[i * 8], &src[(size_t)i * srcStride],
    93	               8 * sizeof(int16_t));
    94	
    95	    partial_butterfly8(block, coef, shift_1st, 8);
    96	    partial_butterfly8(coef, dst, shift_2nd, 8);
    97	}
