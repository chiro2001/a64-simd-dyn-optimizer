   289	    nodes = ir.nodes
   290	    bydst = {n.get("dst"): n for n in nodes if n.get("dst")}
   291	    loads = [n for n in nodes
   292	             if n.get("op") == "load" and n.get("const_name")
   293	             and (n["const_off"] // 16) in (1, 3, 5, 7)]
   294	    if not loads:
   295	        return ir
