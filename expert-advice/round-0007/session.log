    12	//       width), memcmp(width*width*sizeof(int16_t))
    13	//
    14	// Fidelity note: upstream TestBench constructs several harness objects with
    15	// the default (unseeded) rand stream before srand(seed); those objects only
    16	// shift the stream, not the distributions used here. The input distribution
    17	// and the uniform-3 index selection are reproduced exactly; the exact index
    18	// sequence for one historical run is not (it depended on wall-clock seed and
    19	// on the global construction order).
    20	//
    21	// Usage:
    22	//   upstream_contract                      # contract run, seed=time(NULL)
    23	//   upstream_contract --iters N --seed S   # stress, N iterations, fixed seed
    24	//   upstream_contract --sweep K --seed S   # K independent 128-iter runs
    25	//   upstream_contract --uniform --iters N  # full-range uniform [-255,255]
    26	//                                          # diagnostic (stricter than x265)
    27	#include <cstdint>
    28	#include <ctime>
    29	#include <cstdio>
    30	#include <cstdlib>
    31	#include <cstring>
    32	#include <vector>
    33	
    34	namespace x265
    35	{
    36	using dct_t = void (*)(const int16_t*, int16_t*, intptr_t);
    37	void dct4_c(const int16_t*, int16_t*, intptr_t);
    38	void dct8_c(const int16_t*, int16_t*, intptr_t);
    39	void dct16_c(const int16_t*, int16_t*, intptr_t);
    40	void dct32_c(const int16_t*, int16_t*, intptr_t);
    41	void dct4_neon(const int16_t*, int16_t*, intptr_t);
    42	void dct8_neon(const int16_t*, int16_t*, intptr_t);
    43	void dct16_neon(const int16_t*, int16_t*, intptr_t);
    44	void dct32_neon(const int16_t*, int16_t*, intptr_t);
    45	}
    46	
    47	namespace
    48	{
    49	constexpr int kPixelMax = 255;          // X265_DEPTH == 8
    50	constexpr int kIncr = 16;               // MBDstHarness::INCR
    51	constexpr int kContractIters = 128;     // MBDstHarness::ITERS
    52	
    53	struct Entry
    54	{
    55	    const char* name;
    56	    int width;
    57	    x265::dct_t ref;
    58	    x265::dct_t opt;
    59	};
    60	
    61	const Entry kEntries[] =
    62	{
    63	    { "dct4x4",   4,  x265::dct4_c,  x265::dct4_neon },
    64	    { "dct8x8",   8,  x265::dct8_c,  x265::dct8_neon },
    65	    { "dct16x16", 16, x265::dct16_c, x265::dct16_neon },
    66	    { "dct32x32", 32, x265::dct32_c, x265::dct32_neon },
    67	};
    68	
    69	// rand() is deliberately used to mirror upstream (glibc LCG on both the x86
    70	// host build and the aarch64 runtime under qemu).
    71	void fill_contract_case(int16_t* dst, size_t n, int case_idx)
    72	{
    73	    for (size_t i = 0; i < n; i++)
    74	    {
    75	        if (case_idx == 0)
    76	            dst[i] = (int16_t)((rand() & kPixelMax) - (rand() & kPixelMax));
    77	        else if (case_idx == 1)
    78	            dst[i] = (int16_t)-kPixelMax;
    79	        else
    80	            dst[i] = (int16_t)kPixelMax;
    81	    }
    82	}
    83	
    84	uint64_t run_contract(int iters, unsigned seed, int& sizes_failed)
    85	{
    86	    srand(seed);
    87	    const size_t buf_size = 32u * 32u + (size_t)iters * kIncr;
    88	    std::vector<std::vector<int16_t>> cases(3);
    89	    for (int c = 0; c < 3; c++)
    90	    {
    91	        cases[c].resize(buf_size);
    92	        fill_contract_case(cases[c].data(), buf_size, c);
    93	    }
    94	
    95	    uint64_t total_mismatches = 0;
    96	    sizes_failed = 0;
    97	    printf("contract seed=%u iters=%d\n", seed, iters);
    98	
    99	    for (const Entry& e : kEntries)
   100	    {
   101	        const size_t out_elems = (size_t)e.width * e.width;
   102	        std::vector<int16_t> out_ref(out_elems), out_opt(out_elems);
   103	        size_t j = 0;
   104	        uint64_t mismatches = 0;
   105	        for (int i = 0; i < iters; i++)
   106	        {
   107	            const int index = rand() % 3;
   108	            const int16_t* src = cases[index].data() + j;
   109	            e.ref(src, out_ref.data(), e.width);
   110	            e.opt(src, out_opt.data(), e.width);
   111	            if (memcmp(out_ref.data(), out_opt.data(),
   112	                       out_elems * sizeof(int16_t)) != 0)
   113	                mismatches++;
   114	            j += kIncr;
   115	        }
   116	        total_mismatches += mismatches;
   117	        if (mismatches)
   118	            sizes_failed++;
   119	        printf("  %-8s mismatches=%llu/%d %s\n", e.name,
   120	               (unsigned long long)mismatches, iters,
   121	               mismatches ? "FAIL" : "PASS");
   122	    }
   123	    return total_mismatches;
   124	}
   125	
   126	uint64_t run_uniform(int iters, unsigned seed, int& sizes_failed)
   127	{
   128	    // Uniform full-range residual probe, [-255,255]: the stricter diagnostic
   129	    // used by kernels/dct8/dct8_verify.cpp. Stride is randomized among the
   130	    // four values used there; upstream's own harness never does this.
   131	    uint32_t state = seed ? seed : 0xD8C82026u;
   132	    auto next = [&state]() {
   133	        state ^= state << 13;
   134	        state ^= state >> 17;
   135	        state ^= state << 5;
   136	        return state;
   137	    };
   138	    const int strides[4] = { 8, 16, 17, 32 };
   139	    uint64_t total_mismatches = 0;
   140	    sizes_failed = 0;
   141	    printf("uniform seed=%u iters=%d\n", seed, iters);
   142	
   143	    for (const Entry& e : kEntries)
   144	    {
   145	        const size_t out_elems = (size_t)e.width * e.width;
   146	        std::vector<int16_t> buf((size_t)e.width * 32 + 8);
   147	        std::vector<int16_t> out_ref(out_elems), out_opt(out_elems);
   148	        uint64_t mismatches = 0;
   149	        for (int i = 0; i < iters; i++)
   150	        {
   151	            const int stride = strides[next() % 4];
   152	            for (size_t k = 0; k < buf.size(); k++)
   153	                buf[k] = (int16_t)((int)(next() & 0x1FFu) - 255);
   154	            e.ref(buf.data(), out_ref.data(), stride);
   155	            e.opt(buf.data(), out_opt.data(), stride);
   156	            if (memcmp(out_ref.data(), out_opt.data(),
   157	                       out_elems * sizeof(int16_t)) != 0)
   158	                mismatches++;
   159	        }
   160	        total_mismatches += mismatches;
   161	        if (mismatches)
   162	            sizes_failed++;
   163	        printf("  %-8s mismatches=%llu/%d %s\n", e.name,
   164	               (unsigned long long)mismatches, iters,
   165	               mismatches ? "FAIL" : "PASS");
   166	    }
   167	    return total_mismatches;
   168	}
   169	
   170	struct Args
   171	{
   172	    int iters = kContractIters;
   173	    unsigned seed = 0;   // 0 = time(NULL), mirroring upstream TestBench
   174	    unsigned sweep = 1;
   175	    bool uniform = false;
   176	};
   177	
   178	bool parse_args(int argc, char** argv, Args& a)
   179	{
   180	    for (int i = 1; i < argc; i++)
   181	    {
   182	        if (!strcmp(argv[i], "--iters") && i + 1 < argc)
   183	            a.iters = atoi(argv[++i]);
   184	        else if (!strcmp(argv[i], "--seed") && i + 1 < argc)
   185	            a.seed = (unsigned)strtoul(argv[++i], nullptr, 0);
   186	        else if (!strcmp(argv[i], "--sweep") && i + 1 < argc)
   187	            a.sweep = (unsigned)strtoul(argv[++i], nullptr, 0);
   188	        else if (!strcmp(argv[i], "--uniform"))
   189	            a.uniform = true;
   190	        else
   191	        {
   192	            fprintf(stderr, "unknown arg: %s\n", argv[i]);
   193	            return false;
   194	        }
   195	    }
   196	    if (a.iters < 1 || a.sweep < 1)
   197	        return false;
   198	    return true;
   199	}
   200	} // namespace
   201	
   202	int main(int argc, char** argv)
   203	{
   204	    Args a;
   205	    if (!parse_args(argc, argv, a))
   206	    {
   207	        fprintf(stderr,
   208	                "usage: %s [--iters N] [--seed S] [--sweep K] [--uniform]\n",
   209	                argv[0]);
   210	        return 2;
   211	    }
   212	    if (a.seed == 0)
   213	        a.seed = (unsigned)time(nullptr);
   214	
   215	    int worst_sizes_failed = 0;
   216	    unsigned failing_runs = 0;
   217	    uint64_t total = 0;
   218	    for (unsigned k = 0; k < a.sweep; k++)
   219	    {
   220	        const unsigned seed = a.seed + k;
   221	        int sizes_failed = 0;
   222	        total += a.uniform ? run_uniform(a.iters, seed, sizes_failed)
   223	                           : run_contract(a.iters, seed, sizes_failed);
   224	        if (sizes_failed > worst_sizes_failed)
   225	            worst_sizes_failed = sizes_failed;
   226	        failing_runs += sizes_failed ? 1u : 0u;
   227	        if (a.sweep > 1)
   228	            printf("run %u: sizes_failed=%d\n", k, sizes_failed);
   229	    }
   230	
   231	    printf("summary: mode=%s sweep=%u runs_failing=%u/%u "
   232	           "max_sizes_failed=%d total_mismatches=%llu\n",
   233	           a.uniform ? "uniform" : "contract", a.sweep, failing_runs,
   234	           a.sweep, worst_sizes_failed, (unsigned long long)total);
   235	
   236	    // A contract run fails only if the upstream NEON kernel disagrees with
   237	    // its own C reference under x265's exact test semantics (any size).
   238	    return failing_runs ? 1 : 0;
   239	}

