   192	    const bool verifyOnly = argc > 6 && std::string(argv[6]) == "--verify-only";
   193	    const bool skipVerify = argc > 6 && std::string(argv[6]) == "--noverify";
   194	
   195	    int shape = 0;
   196	    if (shapeS == "8x8") shape = 8;
   197	    else if (shapeS == "16x16") shape = 16;
   198	    else if (shapeS == "32x32") shape = 32;
   199	    else if (shapeS == "64x64") shape = 64;
   200	    else { fprintf(stderr, "bad shape\n"); return 2; }
   201	
   202	    EncoderPrimitives cprim, neon;
   203	    std::memset(&cprim, 0, sizeof(cprim));
   204	    std::memset(&neon, 0, sizeof(neon));
   205	    setupCPrimitives(cprim);
   206	    setupAliasPrimitives(cprim);
   207	    const int cpu = cpu_detect(false);
   208	    setupIntrinsicPrimitives(neon, cpu);
   209	    setupAssemblyPrimitives(neon, cpu);
   210	    setupAliasPrimitives(neon);
   211	
   212	    if (!skipVerify)
   213	    {
   214	        // Only 8x8 is in scope: for 16/32/64 x265 swaps the dct slot to the
   215	        // lowpass transform (primitives.cpp setupAliasPrimitives), which is a
   216	        // different kernel family and can diverge/crash independently.
   217	        const int shapes[] = { 8 };
   218	        int diverged = 0;
   219	        for (size_t i = 0; i < sizeof(shapes) / sizeof(shapes[0]); i++)
   220	            diverged += c_vs_neon_divergence(cprim, neon, shapes[i]);
   221	        fprintf(stderr,
   222	                "c-vs-neon divergence report: %d/20000 cases differ "
   223	                "(upstream NEON is not bit-exact with C on all in-range "
   224	                "inputs; x265 TestBench still passes it).\n", diverged);
   225	        if (verifyOnly && implS != "cand")
   226	            return 0;
   227	    }
   228	
   229	    dct_fn fn = 0;
   230	    if (implS == "c") fn = cprim.cu[shape == 8 ? BLOCK_8x8 : shape == 16 ? BLOCK_16x16 : shape == 32 ? BLOCK_32x32 : BLOCK_64x64].dct;
   231	    else if (implS == "neon") fn = neon.cu[shape == 8 ? BLOCK_8x8 : shape == 16 ? BLOCK_16x16 : shape == 32 ? BLOCK_32x32 : BLOCK_64x64].dct;
   232	    else if (implS == "empty") fn = empty_dct;
   233	    else if (implS == "cand")
   234	    {
   235	        if (shape != 8) { fprintf(stderr, "cand impl only supports 8x8\n"); return 2; }
   236	        fn = DYNOPT_CANDIDATE;
   237	    }
   238	    else { fprintf(stderr, "bad impl\n"); return 2; }
   239	    if (!fn) { fprintf(stderr, "impl pointer is NULL\n"); return 2; }
   240	
   241	    if (!skipVerify && implS == "cand")
   242	    {
   243	        if (!verify_candidate(fn, cprim, shape))
   244	        {
   245	            fprintf(stderr, "candidate differential verification FAILED\n");
   246	            return 1;
   247	        }
   248	        fprintf(stderr, "candidate verification OK (cand == C reference on 20k random cases)\n");
   249	        if (verifyOnly)
   250	            return 0;
   251	    }
   252	
   253	    const bool latency = modeS == "latency";
   254	    if (modeS != "latency" && modeS != "throughput")
   255	    { fprintf(stderr, "bad mode\n"); return 2; }
   256	
   257	    const Corpus corpus(shape);
   258	    uint64_t dummyTicks = 0;
   259	    for (int i = 0; i < 64; i++)
   260	        run_batch(fn, corpus, shape, 512, latency, &dummyTicks);
   261	
   262	    printf("shape,impl,mode,sample,batch,ns,ticks,checksum\n");
   263	    for (int s = 0; s < samples; s++)
   264	    {
   265	        const auto t0 = std::chrono::steady_clock::now();
