   465	                         % (types[dst], cid(dst), fn, cid(node["src"])))
   466	        elif op == "store":
   467	            base_val = env[node["ptr"]]
   468	            base, off = base_val[1], base_val[2]
   469	            off_s = str(off) if isinstance(off, int) else off
