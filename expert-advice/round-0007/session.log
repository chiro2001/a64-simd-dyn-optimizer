   110	def mul64_to_shift(ir):
   111	    """Replace exact ×64 lane-constant multiplies with a shift by 6.
   112	
   113	    In the DCT8 even rows, `mul<s32>(x, <64,64,64,64>)` equals `x << 6`
   114	    exactly (no overflow for the kernel's value range). vshlq_n is cheaper
   115	    than vmulq on most pipelines. This is the smallest rewrite in the
   116	    catalog, demonstrating the search loop making a real instruction
   117	    selection choice.
   118	    """
   119	    changed = 0
   120	    for n in ir.nodes:
   121	        if n.get("op") == "mul" and n.get("const_vec") == [64, 64, 64, 64]:
   122	            n["op"] = "shl"
   123	            n["amt"] = 6
   124	            n.pop("const_vec", None)
   125	            changed += 1
   126	    return ir
