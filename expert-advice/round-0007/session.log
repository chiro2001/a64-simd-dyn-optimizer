    47	### 3.2 全范围 uniform 诊断（比 x265 内部 test 更严）
    48	
    49	`--uniform`：输入在整个 [-255,255] 均匀随机、stride 在 {8,16,17,32} 随机
    50	（`kernels/dct8/dct8_verify.cpp` 同款探针），200000 例，qemu/N1/920B 三处
    51	输出完全一致：
    52	
    53	| kernel | 与 C 参考分歧 | 率 |
    54	| --- | ---: | ---: |
    55	| dct4_neon | 0 | 0 |
    56	| dct8_neon | 1821 | **0.91%** |
    57	| dct16_neon | 7 | **0.0035%** |
    58	| dct32_neon | 0 | 0 |
    59	
    60	dct8 的 0.91% 复现 M12/M14 已知的 pass2 `vsub_s16` 回绕；dct16 的 7 例为
    61	本轮新发现（未做最小化，仅记录）。
    62	
    63	## 4. 结论与后续
    64	
    65	1. 开源 DCT NEON kernel 通过 x265 内部 test 是确定的，内部 test 未采样的
    66	   全范围输入上仍与 C 参考存在分歧（dct8 0.91%、dct16 0.0035%）；
    67	2. 本项目当前的 C-exact 门禁是 x265 内部 test 的**严格超集**：通过
    68	   C-exact 的候选必然通过 x265 内部 test（M14 widened 候选实测通过），
    69	   不建议为了小幅优化自由度放宽到“仅过内部 test”，除非用户明确要求；
    70	3. 本轮不改变优化门禁，仅把“开源 kernel 原样可通过 x265 内部 test”作为
    71	   已验证事实记录。
   120	               (unsigned long long)mismatches, iters,
   121	               mismatches ? "FAIL" : "PASS");
   122	    }
   123	    return total_mismatches;
   124	}
   125	
   126	uint64_t run_uniform(int iters, unsigned seed, int& sizes_failed)
   127	{
   128	    // Uniform full-range residual probe, [-255,255]: the stricter diagnostic
   129	    // used by kernels/dct8/dct8_verify.cpp. Stride is randomized among the
   130	    // four values used there; upstream's own harness never does this.
   131	    uint32_t state = seed ? seed : 0xD8C82026u;
   132	    auto next = [&state]() {
   133	        state ^= state << 13;
   134	        state ^= state >> 17;
   135	        state ^= state << 5;
   136	        return state;
   137	    };
   138	    const int strides[4] = { 8, 16, 17, 32 };
   139	    uint64_t total_mismatches = 0;
   140	    sizes_failed = 0;
   141	    printf("uniform seed=%u iters=%d\n", seed, iters);
   142	
   143	    for (const Entry& e : kEntries)
   144	    {
   145	        const size_t out_elems = (size_t)e.width * e.width;
   146	        std::vector<int16_t> buf((size_t)e.width * 32 + 8);
   147	        std::vector<int16_t> out_ref(out_elems), out_opt(out_elems);
   148	        uint64_t mismatches = 0;
   149	        for (int i = 0; i < iters; i++)
   150	        {
   151	            const int stride = strides[next() % 4];
   152	            for (size_t k = 0; k < buf.size(); k++)
   153	                buf[k] = (int16_t)((int)(next() & 0x1FFu) - 255);
   154	            e.ref(buf.data(), out_ref.data(), stride);
   155	            e.opt(buf.data(), out_opt.data(), stride);
   156	            if (memcmp(out_ref.data(), out_opt.data(),
   157	                       out_elems * sizeof(int16_t)) != 0)
   158	                mismatches++;
   159	        }
   160	        total_mismatches += mismatches;
   161	        if (mismatches)
   162	            sizes_failed++;
   163	        printf("  %-8s mismatches=%llu/%d %s\n", e.name,
   164	               (unsigned long long)mismatches, iters,
   165	               mismatches ? "FAIL" : "PASS");
   166	    }
   167	    return total_mismatches;
   168	}
   169	
   170	struct Args
   171	{
   172	    int iters = kContractIters;
   173	    unsigned seed = 0;   // 0 = time(NULL), mirroring upstream TestBench
   174	    unsigned sweep = 1;
   175	    bool uniform = false;
   176	};
   177	
   178	bool parse_args(int argc, char** argv, Args& a)
   179	{
   180	    for (int i = 1; i < argc; i++)
   181	    {
   182	        if (!strcmp(argv[i], "--iters") && i + 1 < argc)
   183	            a.iters = atoi(argv[++i]);
   184	        else if (!strcmp(argv[i], "--seed") && i + 1 < argc)
   185	            a.seed = (unsigned)strtoul(argv[++i], nullptr, 0);
   186	        else if (!strcmp(argv[i], "--sweep") && i + 1 < argc)
   187	            a.sweep = (unsigned)strtoul(argv[++i], nullptr, 0);
   188	        else if (!strcmp(argv[i], "--uniform"))
   189	            a.uniform = true;
   190	        else
   191	        {
   192	            fprintf(stderr, "unknown arg: %s\n", argv[i]);
   193	            return false;
   194	        }
   195	    }
   196	    if (a.iters < 1 || a.sweep < 1)
   197	        return false;
   198	    return true;
   199	}
   200	} // namespace
   201	
   202	int main(int argc, char** argv)
   203	{
   204	    Args a;
   205	    if (!parse_args(argc, argv, a))
   206	    {
   207	        fprintf(stderr,
   208	                "usage: %s [--iters N] [--seed S] [--sweep K] [--uniform]\n",
   209	                argv[0]);
   210	        return 2;
   211	    }
   212	    if (a.seed == 0)
   213	        a.seed = (unsigned)time(nullptr);
   214	
   215	    int worst_sizes_failed = 0;
   216	    unsigned failing_runs = 0;
   217	    uint64_t total = 0;
   218	    for (unsigned k = 0; k < a.sweep; k++)
   219	    {
   220	        const unsigned seed = a.seed + k;
   221	        int sizes_failed = 0;
   222	        total += a.uniform ? run_uniform(a.iters, seed, sizes_failed)
   223	                           : run_contract(a.iters, seed, sizes_failed);
   224	        if (sizes_failed > worst_sizes_failed)
   225	            worst_sizes_failed = sizes_failed;
   226	        failing_runs += sizes_failed ? 1u : 0u;
   227	        if (a.sweep > 1)
   228	            printf("run %u: sizes_failed=%d\n", k, sizes_failed);
   229	    }
   230	
   231	    printf("summary: mode=%s sweep=%u runs_failing=%u/%u "
   232	           "max_sizes_failed=%d total_mismatches=%llu\n",
   233	           a.uniform ? "uniform" : "contract", a.sweep, failing_runs,
   234	           a.sweep, worst_sizes_failed, (unsigned long long)total);
   235	
   236	    // A contract run fails only if the upstream NEON kernel disagrees with
   237	    // its own C reference under x265's exact test semantics (any size).
   238	    return failing_runs ? 1 : 0;
   239	}

