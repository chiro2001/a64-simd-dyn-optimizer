     1	#!/usr/bin/env python3
     2	"""v0 search driver: rewrite -> codegen -> compile -> disasm -> cost -> rank.
     3	
     4	The P6' validation showed the calibrated critical-path model generalizes only
     5	WITHIN the fitted family (920B DCT8 R2=0.98). This driver is therefore
     6	family-scoped: it enumerates MachineIR rewrites for one contract, generates
     7	C++, cross-compiles, disassembles, and ranks candidates with the fitted
     8	per-machine weights. Cross-family ranking stays gated (m19).
     9	
    10	Usage:
    11	  python3 tools/search_driver.py <machine-ir.json> <machine:n1|920b>
    12	      <outdir> [--rewrite widen]...
    13	  machine selects experiments/m16-dct8-protoc/fitted-{n1,920b}.json
    14	"""
    15	
    16	import json
    17	import os
    18	import subprocess
    19	import sys
