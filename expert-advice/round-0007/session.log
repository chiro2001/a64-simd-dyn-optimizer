    87	        t01 = vpaddq_s32(vmulq_s32(vmovl_s16(c5), O[j + 0]),
    88	                         vmulq_s32(vmovl_s16(c5), O[j + 1]));
    89	        t23 = vpaddq_s32(vmulq_s32(vmovl_s16(c5), O[j + 2]),
    90	                         vmulq_s32(vmovl_s16(c5), O[j + 3]));
    91	        res[b][5] = vrshrn_n_s32(vpaddq_s32(t01, t23), shift);
