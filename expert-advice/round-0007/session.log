   179	    if (argc < 6)
   180	    {
   181	        fprintf(stderr,
   182	                "usage: %s <8x8|16x16|32x32|64x64> <c|neon|empty|cand> "
   183	                "<latency|throughput> <samples> <batch> [--verify-only]\n",
   184	                argv[0]);
