   248	
   249	def _dct8_ptr(env, node):
   250	    """Resolve a DCT8 address node to (base, byte_offset) or scalar."""
   251	    rhs = node["rhs"]
   252	    m = re.match(
   253	        r"getelementptr\s+inbounds\s+(?:nuw\s+)?(i8|i16),\s*ptr\s+"
   254	        r"%([A-Za-z0-9._]+),\s*(?:i64\s+)?(%[A-Za-z0-9._]+|\d+)", rhs)
   255	    if m:
   256	        elem, base, off = m.group(1), m.group(2), m.group(3)
   257	        scale = 2 if elem == "i16" else 1
   258	        if off.startswith("%"):
   259	            off = env[off[1:]]
   260	        else:
   261	            off = int(off)
   262	        base_val = env[base]
   263	        if isinstance(base_val, tuple) and base_val[0] == "ptr":
   264	            if isinstance(off, int):
   265	                delta = off * scale
   266	            else:
   267	                delta = off if scale == 1 else "(%d * (%s))" % (scale, off)
   268	            cur = base_val[2]
   269	            if isinstance(cur, int) and cur == 0:
   270	                cur = delta
   271	            elif isinstance(cur, int) and isinstance(delta, int):
   272	                cur = cur + delta
   273	            elif isinstance(delta, int) and delta == 0:
   274	                pass
   275	            else:
   276	                cur = "(%s + %s)" % (cur, delta)
   277	            return ("ptr", base_val[1], cur)
   278	        raise ValueError("unsupported DCT8 base: %r" % rhs)
   279	    g = re.match(
   280	        r"getelementptr\s+inbounds\s+nuw\s+\(i8,\s*ptr\s+"
   281	        r"@([A-Za-z0-9._]+),\s*i64\s+(\d+)\)", rhs)
   282	    if g:
   283	        return ("ptr", "g_t8:" + g.group(1), int(g.group(2)))
   284	    raise ValueError("unsupported DCT8 addr form: %r" % rhs)
   285	
   286	
   287	def emit_dct8_c_intrinsics(machine_ir,
   288	                           func_name="dynopt_dct8_neon_candidate"):
   289	    """Emit a C++ NEON roundtrip for the DCT8 seed MachineIR.
   290	
   291	    Covers the exact op set of the clang-extracted dct8_neon seed: vector
   292	    loads/stores, i8/i16 getelementptr addressing, scalar i64 address math,
   293	    sext (vmovl), add/sub (vadd/vsub), per-lane constant vector multiply
   294	    (vmulq_s32 from a constant pool), shl (vshlq_n_s32 / scalar), the four
   295	    shuffle masks (vrev64/vzip), and the smull/addp/rshrn intrinsic family.
   296	    """
   297	    lines = [
   298	        "// generated by optimizer/ir/codegen.py emit_dct8_c_intrinsics",
   299	        "#include <arm_neon.h>",
   300	        "#include <cstddef>",
   301	        "#include <stdint.h>",
   302	        "",
   303	        "static const int16_t dct8_g_t8[8][8] =",
   304	        "{",
   305	    ]
   306	    lines.extend(G_T8_ROWS)
   307	    lines.extend([
   308	        "};",
   309	        "",
   310	        "extern \"C\" void %s(const int16_t* src, int16_t* dst,"
   311	        " intptr_t srcStride)" % func_name,
   312	        "{",
   313	    ])
   314	    env = {"0": ("ptr", "src", 0), "1": ("ptr", "dst", 0),
   315	           "2": "srcStride"}
   316	    types = {}
   317	    cname = {}
   318	    const_pool = {}   # tuple const -> ("cN", int32_t)
   319	
   320	    def cid(name):
   321	        if name not in cname:
   322	            cname[name] = "v%d" % len(cname)
   323	        return cname[name]
   324	
   325	    def const_vec_id(vec):
   326	        key = tuple(vec)
   327	        if key not in const_pool:
   328	            ident = "c%d" % len(const_pool)
   329	            const_pool[key] = ident
   330	            # emit the pool entry lazily at the end via a header block
   331	        return const_pool[key]
   332	
   333	    for node in machine_ir.nodes:
   334	        op = node["op"]
   335	        dst = node.get("dst")
   336	        if op == "addr":
   337	            env[dst] = _dct8_ptr(env, node)
   338	        elif op in ("shl", "mul", "mla"):
   339	            src = node["src"]
   340	            if node["type"] and node["type"].startswith("<"):
   341	                types[dst] = DCT8_TYPE_MAP[node["type"]]
   342	                if op == "shl":
   343	                    lines.append("    %s %s = vshlq_n_s32(%s, %d);"
   344	                                 % (types[dst], cid(dst), cid(src[0]),
   345	                                    node["amt"]))
   346	                elif node.get("const_vec"):
   347	                    vec = node["const_vec"]
   348	                    splat = vec[0] == vec[1] == vec[2] == vec[3]
   349	                    if op == "mla" and splat:
   350	                        lines.append("    %s %s = vmlaq_n_s32(%s, %s, %d);"
   351	                                     % (types[dst], cid(dst), cid(src[0]),
   352	                                        cid(src[1]), vec[0]))
   353	                    elif op == "mla":
   354	                        cidn = const_vec_id(vec)
   355	                        lines.append("    %s %s = vmlaq_s32(%s, %s,"
   356	                                     " vld1q_s32((const int32_t*)%s));"
   357	                                     % (types[dst], cid(dst), cid(src[0]),
   358	                                        cid(src[1]), cidn))
   359	                    elif splat:
   360	                        lines.append("    %s %s = vmulq_n_s32(%s, %d);"
   361	                                     % (types[dst], cid(dst), cid(src[0]),
   362	                                        vec[0]))
   363	                    else:
   364	                        cidn = const_vec_id(vec)
   365	                        lines.append("    %s %s = vmulq_s32(%s,"
   366	                                     " vld1q_s32((const int32_t*)%s));"
   367	                                     % (types[dst], cid(dst), cid(src[0]),
   368	                                        cidn))
   369	                else:
   370	                    fn = "vmlaq_s32" if op == "mla" else "vmulq_s32"
   371	                    lines.append("    %s %s = %s(%s, %s);"
   372	                                 % (types[dst], cid(dst), fn, cid(src[0]),
   373	                                    cid(src[1])))
   374	            else:
   375	                a = env[src[0]]
   376	                if op == "shl":
   377	                    env[dst] = a << node["amt"] if isinstance(a, int) \
   378	                        else "((%s) << %d)" % (a, node["amt"])
   379	                elif node.get("const") is not None:
   380	                    env[dst] = a * node["const"] if isinstance(a, int) \
   381	                        else "((%s) * %d)" % (a, node["const"])
