    57	def widen_s16_overflow_subs(ir, sub_ids):
    58	    """Widen a set of s16 sub nodes to s32, including their smull consumers.
    59	
    60	    Range-agnostic core shared with widen_dct8_pass2_odd: for each flagged
    61	    `<4 x i16> sub` the operands are sign-extended, the sub becomes `<4 x
    62	    i32>`, and any consuming `smull` becomes `mul<s32>(sext(coef), O)` so the
    63	    dot product stays exact. Consumers after the widened sub keep their
    64	    existing s32 pipeline.
    65	    """
    66	    nodes = ir.nodes
    67	    bydst = {n.get("dst"): n for n in nodes}
    68	    targets = set(sub_ids)
    69	    dst_by_id = {n.get("id"): n.get("dst") for n in nodes
    70	                 if n.get("id") is not None}
    71	    widened_dsts = {dst_by_id[i] for i in targets if i in dst_by_id}
    72	    out = []
    73	    for n in nodes:
    74	        if n.get("id") in targets:
    75	            wa = "w_%s_a" % n["dst"]
    76	            wb = "w_%s_b" % n["dst"]
    77	            out.append({"op": "sext", "type": "<4 x i32>",
    78	                        "src": n["src"][0], "dst": wa})
    79	            out.append({"op": "sext", "type": "<4 x i32>",
    80	                        "src": n["src"][1], "dst": wb})
    81	            out.append({"op": "sub", "type": "<4 x i32>",
    82	                        "src": [wa, wb], "dst": n["dst"]})
    83	            continue
    84	        if n["op"] == "intrinsic" and n["intrinsic"] == "smull" \
    85	                and n["args"][1]["ref"] in widened_dsts:
    86	            wc = "w_%s_c" % n["dst"]
    87	            out.append({"op": "sext", "type": "<4 x i32>",
    88	                        "src": n["args"][0]["ref"], "dst": wc})
    89	            out.append({"op": "mul", "type": "<4 x i32>",
    90	                        "src": [wc, n["args"][1]["ref"]], "dst": n["dst"]})
    91	            continue
    92	        out.append(n)
    93	    for i, n in enumerate(out):
    94	        n["id"] = i
    95	    ir.nodes = out
    96	    return ir
