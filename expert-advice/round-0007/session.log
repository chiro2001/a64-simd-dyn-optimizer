    93	def estimate_critical_path(text, latency_table=None):
    94	    """Return (critical_path, dist, lines, preds) over objdump text."""
    95	    lat = latency_table or MNEMONIC_LATENCY
    96	    insts = []
    97	    lines = []
    98	    for line in text.splitlines():
    99	        p = parse_inst(line)
   100	        if p:
   101	            mn, dst, reads = p
   102	            insts.append((mn, dst, reads, lat.get(mn, 1)))
   103	            lines.append(line)
   104	
   105	    last_writer = {}
   106	    preds = [[] for _ in insts]
   107	    for i, (mn, dst, reads, _) in enumerate(insts):
   108	        for r in reads:
   109	            if r in last_writer:
   110	                preds[i].append(last_writer[r])
   111	        if dst is not None:
   112	            last_writer[dst] = i
   113	
   114	    dist = []
   115	    best = 0.0
   116	    for i, (mn, dst, reads, l) in enumerate(insts):
   117	        d = l + max((dist[p] for p in preds[i]), default=0)
   118	        dist.append(d)
   119	        best = max(best, d)
   120	    return best, dist, lines, preds
   121	
   122	
   123	def load_mnemonic_hist(text):
   124	    hist = defaultdict(int)
   125	    for line in text.splitlines():
   126	        m = re.match(r"\s*[0-9a-f]+:\s+[0-9a-f]{8}\s+([a-z0-9]+)", line)
   127	        if m:
   128	            hist[m.group(1)] += 1
   129	    return dict(hist)
     1	#!/usr/bin/env python3
     2	"""Print the critical-path latency estimate for a disassembly text file.
     3	
     4	Usage:
     5	  aarch64-linux-gnu-objdump -d f.o | python3 tools/critical_path.py -
     6	  python3 tools/critical_path.py <disasm.txt> [<disasm2.txt> ...]
     7	  python3 tools/critical_path.py --fit 'name:tick,name:tick' <disasm...>
     8	
     9	--fit fits per-mnemonic latencies so that each candidate's longest-path cost
    10	approximates its measured ticks; this calibrates the seed table per machine.
    11	"""
    12	
    13	import collections
    14	import sys
    15	
    16	import numpy as np
    17	
    18	from optimizer.analysis.critical_path import MNEMONIC_LATENCY, parse_inst, \
    19	    estimate_critical_path, load_mnemonic_hist
    20	
    21	
    22	def main():
    23	    if len(sys.argv) < 2:
    24	        print(__doc__)
    25	        return 2
    26	    chain = "--chain" in sys.argv
    27	    fit = None
    28	    out_path = None
    29	    argv = sys.argv[1:]
    30	    for a in sys.argv[1:]:
    31	        if a.startswith("--fit="):
    32	            fit = a.split("=", 1)[1]
    33	        elif a == "--out":
    34	            out_path = sys.argv[sys.argv.index(a) + 1]
    35	    paths = [p for p in argv
    36	             if not p.startswith("--") and p != "-"
    37	             and p != out_path]
    38	    if "-" in argv:
    39	        paths.insert(0, "-")
    40	    if fit:
    41	        specs = [s.split(":") for s in fit.split(",")]
    42	        ticks = {name: float(t) for name, t in specs}
    43	        texts = {}
    44	        for path, (name, t) in zip(paths, specs):
    45	            texts[name] = sys.stdin.read() if path == "-" \
    46	                else open(path).read()
    47	        # longest-path mnemonic composition per candidate
    48	        rows = {}
    49	        mnems = set()
    50	        for name, text in texts.items():
    51	            _, dist, lines, preds = estimate_critical_path(text)
    52	            i = max(range(len(dist)), key=dist.__getitem__)
    53	            comp = collections.Counter()
    54	            while True:
    55	                comp[parse_inst(lines[i])[0]] += 1
    56	                if preds[i]:
    57	                    i = max(preds[i], key=dist.__getitem__)
    58	                else:
    59	                    break
    60	            rows[name] = comp
    61	            mnems |= set(comp)
    62	        mnems = sorted(mnems)
    63	        names = [n for n, _ in specs]
    64	        X = np.array([[rows[n].get(m, 0) for m in mnems] for n in names],
    65	                     dtype=float)
    66	        y = np.array([ticks[n] for n in names], dtype=float)
    67	        w, *_ = np.linalg.lstsq(X, y, rcond=None)
    68	        w = np.maximum(w, 0.01)
    69	        pred = X @ w
    70	        print("fitted latencies:")
    71	        for m, wv in sorted(zip(mnems, w), key=lambda p: -p[1]):
    72	            print("   %-8s %.2f (seed %.1f)" % (m, wv,
    73	                                                MNEMONIC_LATENCY.get(m, 1)))
    74	        print("pred/meas:")
    75	        for n, p, t in zip(names, pred, y):
    76	            print("   %-14s pred=%.2f meas=%.2f" % (n, p, t))
    77	        ss = float(np.sum((pred - y) ** 2))
    78	        sst = float(np.sum((y - y.mean()) ** 2)) + 1e-9
    79	        print("R2=%.3f" % (1 - ss / sst))
    80	        import json
    81	        if out_path:
    82	            json.dump({"mnemonics": mnems,
    83	                       "weights": [float(x) for x in w],
    84	                       "names": names, "pred": [float(x) for x in pred],
    85	                       "meas": [float(x) for x in y],
    86	                       "r2": float(1 - ss / sst)},
    87	                      open(out_path, "w"), indent=1)
    88	        return 0
    89	    for path in paths:
    90	        text = sys.stdin.read() if path == "-" else open(path).read()
    91	        cp, dist, lines, preds = estimate_critical_path(text)
    92	        hist = load_mnemonic_hist(text)
    93	        print("%-24s critical_path=%.1f instructions=%d"
    94	              % (path, cp, sum(hist.values())))
    95	        if chain:
    96	            i = max(range(len(dist)), key=dist.__getitem__)
    97	            path = []
    98	            while True:
    99	                path.append(lines[i].strip())
   100	                if preds[i]:
   101	                    i = max(preds[i], key=dist.__getitem__)
   102	                else:
   103	                    break
   104	            for step in reversed(path[:24]):
   105	                print("   ", step)
   106	    return 0
   107	
   108	
   109	if __name__ == "__main__":
   110	    sys.exit(main())

