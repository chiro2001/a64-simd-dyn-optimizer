     1	// Standalone DCT8 microbenchmark + differential harness (tier a: NEON->NEON).
     2	//
     3	// Exposes four implementations in one binary:
     4	//   c     - x265 scalar C reference (setupCPrimitives)
     5	//   neon  - x265 upstream NEON dispatch baseline (setupIntrinsic+Assembly)
     6	//   empty - loop-only harness with identical call shape, returns 0
     7	//   cand  - DYNOPT_CANDIDATE macro symbol (8x8 only, link required)
     8	//
     9	// Usage:
    10	//   dct8_microbench <8x8|16x16|32x32|64x64> <c|neon|empty|cand>
    11	//                   <latency|throughput> <samples> <batch> [--verify-only|--noverify]
    12	//
    13	// Output: one CSV line per sample (ticks column feeds the paired-cycles
    14	// runner when no hardware PMU is available):
    15	//   shape,impl,mode,sample,batch,ns,ticks,checksum
    16	#include "primitives.h"
    17	
    18	#include <chrono>
    19	#include <cstdint>
    20	#include <cstdio>
    21	#include <cstdlib>
    22	#include <cstring>
    23	#include <random>
    24	#include <string>
    25	#include <vector>
    26	
    27	using namespace X265_NS;
    28	
    29	#ifndef DYNOPT_CANDIDATE
    30	#define DYNOPT_CANDIDATE dynopt_dct8_neon_candidate
    31	#endif
    32	extern "C" void DYNOPT_CANDIDATE(
    33	    const int16_t*, int16_t*, intptr_t) __attribute__((weak));
    34	
    35	static const int BUFSZ = 64;
    36	static const int STRIDE = BUFSZ;
    37	static const int CORPUS = 1024;
    38	
    39	typedef void (*dct_fn)(const int16_t*, int16_t*, intptr_t);
    40	
    41	static inline uint64_t read_cntvct()
    42	{
    43	    uint64_t t;
    44	    __asm__ __volatile__("mrs %0, cntvct_el0" : "=r"(t));
    45	    return t;
    46	}
    47	
    48	static void empty_dct(const int16_t*, int16_t*, intptr_t)
    49	{
    50	}
    51	
    52	struct Corpus
    53	{
    54	    std::vector<int16_t> data;         // CORPUS * 64*64
    55	    std::vector<int> offs;
    56	    std::vector<const int16_t*> p;
    57	
    58	    Corpus(int shape)
    59	    {
    60	        std::mt19937 rng(0xD8C8u + shape);
    61	        const int maxOff = BUFSZ - shape;
    62	        data.resize((size_t)CORPUS * BUFSZ * BUFSZ);
    63	        offs.resize(CORPUS);
    64	        p.resize(CORPUS);
    65	        for (int i = 0; i < CORPUS; i++)
    66	        {
    67	            int16_t* a = &data[(size_t)i * BUFSZ * BUFSZ];
    68	            for (int j = 0; j < BUFSZ * BUFSZ; j++)
    69	                a[j] = (int16_t)((int)(rng() & 0x1FF) - 255);   // [-255,255]
    70	            offs[i] = (int)(rng() % (maxOff * maxOff + 1));
    71	            p[i] = a;
    72	        }
    73	    }
    74	
    75	    const int16_t* a(int i) const { return p[i]; }
    76	    int off(int i) const { return offs[i]; }
    77	};
    78	
    79	static int c_vs_neon_divergence(const EncoderPrimitives& cprim,
    80	                                const EncoderPrimitives& neon, int shape)
    81	{
    82	    const LumaCU idx = shape == 8 ? BLOCK_8x8
    83	                     : shape == 16 ? BLOCK_16x16
    84	                     : shape == 32 ? BLOCK_32x32
    85	                                   : BLOCK_64x64;
    86	    const int maxOff = BUFSZ - shape;
    87	    std::mt19937 rng(0xC8C0u + shape);
    88	    int mismatches = 0;
    89	    for (int t = 0; t < 20000; t++)
    90	    {
    91	        if (getenv("DCT8_TRACE") && t % 100 == 0)
    92	            fprintf(stderr, "t=%d\n", t);
    93	        int16_t a[64 * 64], want[64 * 64], got[64 * 64];
    94	        for (int i = 0; i < BUFSZ * BUFSZ; i++)
    95	            a[i] = (int16_t)((int)(rng() & 0x1FF) - 255);
    96	        const int off = maxOff > 0
    97	            ? (int)(rng() % (maxOff * maxOff + 1)) : 0;
    98	        const int ox = maxOff > 0 ? off % maxOff : 0;
    99	        const int oy = maxOff > 0 ? off / maxOff : 0;
   100	        const int16_t* pa = a + (size_t)oy * STRIDE + ox;
   101	        cprim.cu[idx].dct(pa, want, STRIDE);
   102	        neon.cu[idx].dct(pa, got, STRIDE);
   103	        if (memcmp(want, got, (size_t)shape * shape * sizeof(int16_t)) != 0)
   104	        {
   105	            if (mismatches < 5)
   106	                fprintf(stderr, "MISMATCH shape=%d off=(%d,%d)\n",
   107	                        shape, ox, oy);
   108	            mismatches++;
   109	        }
   110	    }
   111	    return mismatches;
   112	}
   113	
   114	static bool verify_candidate(dct_fn fn, const EncoderPrimitives& cprim,
   115	                             int shape)
   116	{
   117	    const LumaCU idx = BLOCK_8x8;
   118	    const int maxOff = BUFSZ - shape;
   119	    std::mt19937 rng(0xDCA0u + shape);
   120	    int mismatches = 0;
   121	    for (int t = 0; t < 20000 && mismatches < 5; t++)
   122	    {
   123	        int16_t a[64 * 64], want[64 * 64], got[64 * 64];
   124	        for (int i = 0; i < BUFSZ * BUFSZ; i++)
   125	            a[i] = (int16_t)((int)(rng() & 0x1FF) - 255);
   126	        const int off = maxOff > 0
   127	            ? (int)(rng() % (maxOff * maxOff + 1)) : 0;
   128	        const int ox = maxOff > 0 ? off % maxOff : 0;
   129	        const int oy = maxOff > 0 ? off / maxOff : 0;
   130	        const int16_t* pa = a + (size_t)oy * STRIDE + ox;
   131	        fn(pa, got, STRIDE);
   132	        cprim.cu[idx].dct(pa, want, STRIDE);
   133	        if (memcmp(want, got, (size_t)shape * shape * sizeof(int16_t)) != 0)
   134	        {
   135	        fprintf(stderr, "CAND MISMATCH shape=%d off=(%d,%d)\n",
   136	                shape, ox, oy);
   137	            mismatches++;
   138	        }
   139	    }
   140	    return mismatches == 0;
   141	}
   142	
   143	static int64_t run_batch(dct_fn fn, const Corpus& corpus, int shape,
   144	                         int batch, bool latency, uint64_t* ticksOut)
   145	{
   146	    const uint64_t mask = CORPUS - 1;
   147	    const uint64_t t0 = read_cntvct();
   148	    int16_t out[64 * 64];
   149	    int64_t checksum = 0;
   150	    if (latency)
   151	    {
   152	        uint64_t sel = 0x9E3779B97F4A7C15ull;
   153	        for (int i = 0; i < batch; i++)
   154	        {
   155	            const size_t idx = (sel + (uint64_t)i) & mask;
   156	            fn(corpus.a((int)idx) + corpus.off((int)idx), out, STRIDE);
   157	            // dependent chain for latency mode, without a 64-element sum
   158	            // polluting the per-call cost
   159	            sel = (uint64_t)((uint32_t)out[0] * 0x9E3779B9u
   160	                             + (uint32_t)out[shape * shape - 1]);
   161	            checksum += out[0] + out[shape * shape - 1];
   162	        }
   163	    }
   164	    else
   165	    {
   166	        for (int i = 0; i < batch; i++)
   167	        {
   168	            const size_t idx = (uint64_t)i & mask;
   169	            fn(corpus.a((int)idx) + corpus.off((int)idx), out, STRIDE);
   170	            checksum += out[0] + out[shape * shape - 1];
   171	        }
   172	    }
   173	    *ticksOut = read_cntvct() - t0;
   174	    return checksum;
   175	}
