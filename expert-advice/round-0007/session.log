    93	def estimate_critical_path(text, latency_table=None):
    94	    """Return (critical_path, dist, lines, preds) over objdump text."""
    95	    lat = latency_table or MNEMONIC_LATENCY
    96	    insts = []
    97	    lines = []
    98	    for line in text.splitlines():
    99	        p = parse_inst(line)
   100	        if p:
   101	            mn, dst, reads = p
   102	            insts.append((mn, dst, reads, lat.get(mn, 1)))
   103	            lines.append(line)
   104	
   105	    last_writer = {}
   106	    preds = [[] for _ in insts]
   107	    for i, (mn, dst, reads, _) in enumerate(insts):
   108	        for r in reads:
   109	            if r in last_writer:
   110	                preds[i].append(last_writer[r])
   111	        if dst is not None:
   112	            last_writer[dst] = i
   113	
   114	    dist = []
   115	    best = 0.0
   116	    for i, (mn, dst, reads, l) in enumerate(insts):
   117	        d = l + max((dist[p] for p in preds[i]), default=0)
   118	        dist.append(d)
   119	        best = max(best, d)
   120	    return best, dist, lines, preds
   121	
   122	
   123	def load_mnemonic_hist(text):
   124	    hist = defaultdict(int)
   125	    for line in text.splitlines():
   126	        m = re.match(r"\s*[0-9a-f]+:\s+[0-9a-f]{8}\s+([a-z0-9]+)", line)
   127	        if m:
   128	            hist[m.group(1)] += 1
   129	    return dict(hist)
