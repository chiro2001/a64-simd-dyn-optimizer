     1	#!/usr/bin/env bash
     2	# Randomized paired PMU A/B for SA8D: candidate vs same-machine NEON.
     3	#
     4	# One valid pair = one perf-stat run of each impl (random order) on the
     5	# pinned vCPU. When the hardware PMU is available, cycles:u and
     6	# instructions:u are recorded; otherwise (e.g. a cloud VM without a virtual
     7	# PMU) the script falls back to the microbench's own CNTVCT_EL0 `ticks`
     8	# column, which is still real hardware time. ≥MIN_VALID pairs across ≥3
     9	# processes are required; the bootstrap 95% CI of the per-pair speedup must
    10	# have its lower bound above the keep threshold (default 1.10 for 920B
    11	# NEON->SVE256).
    12	#
    13	# Usage: scripts/run-pmu-sa8d-paired.sh <bench-binary> <shape>
    14	#          [pairs_per_proc=10] [procs=3] [batch=4096] [outdir] [mode=latency]
    15	set -euo pipefail
    16	
    17	ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    18	cd "$ROOT"
    19	
    20	BIN="${1:?usage: run-pmu-sa8d-paired.sh <bench> <shape> [pairs] [procs] [batch] [out]}"
    21	SHAPE="${2:?usage: run-pmu-sa8d-paired.sh <bench> <shape> [pairs] [procs] [batch] [out]}"
    22	PAIRS="${3:-10}"
    23	PROCS="${4:-3}"
    24	BATCH="${5:-4096}"
    25	OUT="${6:-experiments/m11-sve-920b/benchmark/pmu}"
    26	MODE="${7:-latency}"
    27	MIN_VALID="${MIN_VALID:-30}"
    28	KEEP_LO="${KEEP_LO:-1.10}"
    29	CPU="${CPU:-0}"
    30	IMPL_A="${IMPL_A:-neon}"   # baseline (A) = numerator of speedup
    31	IMPL_B="${IMPL_B:-cand}"   # candidate (B) = denominator of speedup
    32	
    33	mkdir -p "$OUT"
    34	RAW="$OUT/paired-pmu-raw.csv"
    35	: > "$RAW"
    36	
    37	METRIC="${METRIC:-auto}"
    38	if [ "$METRIC" = "auto" ] && perf stat -e cycles:u true 2>&1 | grep -q "not supported"; then
    39	  echo "[run-pmu-sa8d-paired] hardware PMU unavailable; metric=cntvct (microbench ticks)"
    40	  METRIC="cntvct"
    41	fi
    42	if [ "$METRIC" = "auto" ]; then
    43	  # Even with a hardware PMU, whole-process cycles dominate small kernels;
    44	  # the microbench's own cntvct ticks measure only the batch loop. Prefer
    45	  # cntvct unless a perf-based metric is explicitly requested.
    46	  METRIC="cntvct"
    47	fi
    48	
    49	run_perf() {
    50	  local impl="$1"
    51	  local tmp
    52	  tmp="$(mktemp)"
    53	  if [ "$METRIC" = "cntvct" ]; then
    54	    taskset -c "$CPU" "$BIN" "$SHAPE" "$impl" "$MODE" 1 "$BATCH" --noverify \
    55	      2>/dev/null | tail -n 1 | awk -F, '{printf "%.0f", $7}'
    56	    return 0
    57	  fi
    58	  if ! perf stat -x, -e cycles:u,instructions:u \
    59	    taskset -c "$CPU" "$BIN" "$SHAPE" "$impl" "$MODE" 1 "$BATCH" --noverify \
    60	      >/dev/null 2>"$tmp"; then
    61	    cat "$tmp" >&2
    62	    rm -f "$tmp"
    63	    echo ","
    64	    return 0
    65	  fi
    66	  awk -F, '$3=="cycles:u"{c=$4} $3=="instructions:u"{i=$4} END{printf "%.0f,%.0f", c, i}' "$tmp"
    67	  rm -f "$tmp"
    68	}
    69	
    70	for p in $(seq 1 "$PROCS"); do
    71	  for s in $(seq 1 "$PAIRS"); do
    72	    order=$((RANDOM % 2))
    73	    if [ "$order" -eq 0 ]; then
    74	      n=$(run_perf "$IMPL_A"); c=$(run_perf "$IMPL_B")
    75	    else
    76	      c=$(run_perf "$IMPL_B"); n=$(run_perf "$IMPL_A")
    77	    fi
    78	    echo "$p,$s,$order,$n,$c" >> "$RAW"
    79	  done
    80	done
    81	
    82	python3 - "$RAW" "$OUT" "$MIN_VALID" "$KEEP_LO" "$BATCH" "$METRIC" "$MODE" <<'PY'
    83	import csv, json, random, statistics, sys
    84	raw, out, min_valid, keep_lo, batch, metric, mode = sys.argv[1:8]
    85	min_valid, keep_lo, batch = int(min_valid), float(keep_lo), int(batch)
    86	
    87	valid = []
    88	with open(raw) as f:
    89	    for r in csv.reader(f):
    90	        if len(r) < 5 or not r[3] or not r[4]:
    91	            continue
    92	        a = [float(x) for x in r[3].split(",") if x.strip()]
    93	        b = [float(x) for x in r[4].split(",") if x.strip()]
    94	        if not a or not b or any(v <= 0 for v in a + b):
    95	            continue
    96	        neon_cyc = a[0] / batch
    97	        cand_cyc = b[0] / batch
    98	        neon_insn = a[1] / batch if len(a) > 1 else float("nan")
    99	        cand_insn = b[1] / batch if len(b) > 1 else float("nan")
   100	        valid.append((int(r[0]), int(r[1]), int(r[2]),
   101	                      neon_cyc, neon_insn, cand_cyc, cand_insn))
   102	
   103	ratios = [n[3] / n[5] for n in valid]          # speedup = neon_cyc / cand_cyc
   104	rng = random.Random(0x920B)
   105	B = 10000
   106	bs = []
   107	for _ in range(B):
   108	    s = [ratios[rng.randrange(len(ratios))] for _ in ratios]
   109	    bs.append(statistics.median(s))
   110	bs.sort()
   111	lo, hi = bs[int(0.025 * B)], bs[int(0.975 * B)]
   112	med = statistics.median(ratios) if ratios else float("nan")
   113	geo = statistics.geometric_mean(ratios) if ratios else float("nan")
   114	nprocs = len(set(n[0] for n in valid))
   115	ok = (len(valid) >= min_valid and lo > keep_lo and nprocs >= 3)
   116	
   117	with open(f"{out}/paired-pmu-summary.txt", "w") as f:
   118	    f.write("valid_pairs=%d procs=%d\n" % (len(valid), nprocs))
   119	    f.write("metric_source=%s\n" % metric)
   120	    f.write("mode=%s\n" % mode)
   121	    f.write("speedup_median=%.4f geomean=%.4f bootstrap95=[%.4f, %.4f]\n"
   122	            % (med, geo, lo, hi))
   123	    f.write("keep_lo=%.3f min_valid=%d verdict=%s\n"
   124	            % (keep_lo, min_valid, "KEEP" if ok else "REJECT"))
   125	
   126	with open(f"{out}/paired-pmu-per-call.csv", "w") as f:
   127	    f.write("proc,pair,order,neon_cyc,neon_insn,cand_cyc,cand_insn\n")
   128	    for v in valid:
   129	        f.write("%d,%d,%d,%.2f,%.2f,%.2f,%.2f\n" % v)
   130	
   131	print(json.dumps({
   132	    "valid_pairs": len(valid), "procs": nprocs,
   133	    "speedup_median": med, "speedup_geomean": geo,
   134	    "bootstrap95": [lo, hi], "keep_lo": keep_lo,
   135	    "metric_source": metric,
   136	    "mode": mode,
   137	    "verdict": "KEEP" if ok else "REJECT",
   138	}))
   139	sys.exit(0 if ok else 1)
   140	PY
   141	
   142	echo "[run-pmu-sa8d-paired] wrote $OUT/paired-pmu-summary.txt"

