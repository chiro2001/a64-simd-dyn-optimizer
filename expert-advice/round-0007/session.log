   387	            vtype = node["type"]
   388	            if vtype and vtype.startswith("<"):
   389	                types[dst] = DCT8_TYPE_MAP[vtype]
   390	                lanes = int(vtype[1:].split(" x ")[0])
   391	                width = int(vtype.split("i")[1].rstrip(">"))
   392	                suffix = "q" if lanes * width >= 128 else ""
   393	                lines.append("    %s %s = v%s%s_s%d(%s, %s);"
   394	                             % (types[dst], cid(dst), op, suffix, width,
   395	                                cid(node["src"][0]), cid(node["src"][1])))
   396	            else:
   397	                a = env[node["src"][0]]
   398	                if len(node["src"]) == 2:
   399	                    b = env[node["src"][1]]
   400	                    if isinstance(a, int) and isinstance(b, int):
   401	                        env[dst] = a + b if op == "add" else a - b
   402	                    else:
   403	                        env[dst] = "(%s %s %s)" % (a, "+" if op == "add"
   404	                                                   else "-", b)
   405	                else:
   406	                    c = node.get("const", 0)
   407	                    env[dst] = (a + c if op == "add" else a - c) \
   408	                        if isinstance(a, int) \
   409	                        else "((%s) %s %d)" % (a, "+" if op == "add"
   410	                                               else "-", c)
   411	        elif op == "sext":
   412	            types[dst] = "int32x4_t"
