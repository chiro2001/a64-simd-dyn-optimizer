   326	    def tree_load(root):
   327	        sext = bydst[_src_list(tree_leaves(root)[0])[0]]
   328	        return bydst[_src_list(sext)[0]]
   329	
   330	    by_oset = defaultdict(list)
   331	    for t in trees:
   332	        oset = frozenset(_src_list(m)[1] for m in tree_leaves(t))
   333	        by_oset[oset].append(t)
   334	
   335	    plans = {}
   336	    for oset, group in by_oset.items():
   337	        if len(group) != 4:
   338	            continue
   339	        group = sorted(group, key=lambda t: tree_load(t)["const_off"])
   340	        col_loads = [tree_load(t) for t in group]
   341	        if len({l["const_off"] for l in col_loads}) != 4:
   342	            continue
   343	        leaves = [tree_leaves(t) for t in group]
   344	        o = [_src_list(leaves[0][i])[1] for i in range(4)]
   345	        if len(set(o)) != 4:
   346	            continue
