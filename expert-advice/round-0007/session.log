    58	        }
    59	
    60	        EE[0] = E[0] + E[3];
    61	        EO[0] = E[0] - E[3];
    62	        EE[1] = E[1] + E[2];
    63	        EO[1] = E[1] - E[2];
    64	
    65	        dst[0] = (int16_t)((g_t8[0][0] * EE[0] + g_t8[0][1] * EE[1] + add) >> shift);
    66	        dst[4 * line] = (int16_t)((g_t8[4][0] * EE[0] + g_t8[4][1] * EE[1] + add) >> shift);
    67	        dst[2 * line] = (int16_t)((g_t8[2][0] * EO[0] + g_t8[2][1] * EO[1] + add) >> shift);
    68	        dst[6 * line] = (int16_t)((g_t8[6][0] * EO[0] + g_t8[6][1] * EO[1] + add) >> shift);
    69	
    70	        dst[line] = (int16_t)((g_t8[1][0] * O[0] + g_t8[1][1] * O[1]
    71	                              + g_t8[1][2] * O[2] + g_t8[1][3] * O[3] + add) >> shift);
    72	        dst[3 * line] = (int16_t)((g_t8[3][0] * O[0] + g_t8[3][1] * O[1]
    73	                                  + g_t8[3][2] * O[2] + g_t8[3][3] * O[3] + add) >> shift);
    74	        dst[5 * line] = (int16_t)((g_t8[5][0] * O[0] + g_t8[5][1] * O[1]
    75	                                  + g_t8[5][2] * O[2] + g_t8[5][3] * O[3] + add) >> shift);
    76	        dst[7 * line] = (int16_t)((g_t8[7][0] * O[0] + g_t8[7][1] * O[1]
    77	                                  + g_t8[7][2] * O[2] + g_t8[7][3] * O[3] + add) >> shift);
