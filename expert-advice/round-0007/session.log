   449	                base_val = env[node["ptr"]]
   450	                if not (isinstance(base_val, tuple) and base_val[0] == "ptr"):
   451	                    raise ValueError("DCT8 load from non-pointer")
   452	                base, off = base_val[1], base_val[2]
   453	                if base == "src":
   454	                    off_s = str(off) if isinstance(off, int) else off
   455	                    fn = "vld1q_s16" if wide else "vld1_s16"
   456	                    lines.append("    %s %s = %s((const int16_t*)"
   457	                                 "((const char*)src + (%s)));"
   458	                                 % (types[dst], cid(dst), fn, off_s))
   459	                else:
   460	                    raise ValueError("DCT8 unknown load base %r" % (base,))
   461	        elif op == "half":
   462	            types[dst] = "int16x4_t"
   463	            fn = "vget_%s_s16" % node["half"]
