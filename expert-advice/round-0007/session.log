   414	                else [node["src"]]
   415	            lines.append("    %s %s = vmovl_s16(%s);"
   416	                         % (types[dst], cid(dst), cid(srcs[0])))
   417	        elif op == "shuffle":
   418	            key = (node["type"], tuple(node["mask"]))
   419	            if key not in DCT8_SHUFFLES and key not in DCT8_COMBINES \
   420	                    and key not in DCT8_TRNS:
   421	                raise ValueError("DCT8 unknown shuffle %r" % (key,))
