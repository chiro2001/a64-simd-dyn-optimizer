    93	        t01 = vpaddq_s32(vmulq_s32(vmovl_s16(c7), O[j + 0]),
    94	                         vmulq_s32(vmovl_s16(c7), O[j + 1]));
    95	        t23 = vpaddq_s32(vmulq_s32(vmovl_s16(c7), O[j + 2]),
    96	                         vmulq_s32(vmovl_s16(c7), O[j + 3]));
    97	        res[b][7] = vrshrn_n_s32(vpaddq_s32(t01, t23), shift);
    98	
    99	        // even columns (upstream structure)
   100	        int32x4_t e0 = vpaddq_s32(EE[j / 2 + 0], EE[j / 2 + 1]);
   101	        res[b][0] = vrshrn_n_s32(vmulq_s32(c0, e0), shift);
   102	        int32x4_t e2a = vmulq_s32(c2, EO[j / 2 + 0]);
   103	        int32x4_t e2b = vmulq_s32(c2, EO[j / 2 + 1]);
   104	        res[b][2] = vrshrn_n_s32(vpaddq_s32(e2a, e2b), shift);
   105	        int32x4_t e4a = vmulq_s32(c4, EE[j / 2 + 0]);
   106	        int32x4_t e4b = vmulq_s32(c4, EE[j / 2 + 1]);
   107	        res[b][4] = vrshrn_n_s32(vpaddq_s32(e4a, e4b), shift);
   108	        int32x4_t e6a = vmulq_s32(c6, EO[j / 2 + 0]);
   109	        int32x4_t e6b = vmulq_s32(c6, EO[j / 2 + 1]);
   110	        res[b][6] = vrshrn_n_s32(vpaddq_s32(e6a, e6b), shift);
