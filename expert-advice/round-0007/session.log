tools/validate_cost_model.py-1-#!/usr/bin/env python3
tools/validate_cost_model.py-2-"""Validate the calibrated critical-path cost model on held-out candidates.
tools/validate_cost_model.py-3-
tools/validate_cost_model.py-4-For one machine: load the fitted mnemonic weights (tools/critical_path.py
tools/validate_cost_model.py-5---fit output), predict each candidate's cost as the dot product of its
tools/validate_cost_model.py-6-longest-path mnemonic composition with the weights, and report the Spearman
tools/validate_cost_model.py-7-rank correlation against measured ticks. A high correlation outside the
tools/validate_cost_model.py-8-fit set means the model generalizes; a weak one means the critical-path
tools/validate_cost_model.py:9:term needs refinement (e.g. per-lane latency groups).
tools/validate_cost_model.py-10-
tools/validate_cost_model.py-11-Usage:
tools/validate_cost_model.py-12-  python3 tools/validate_cost_model.py <fitted.json> \
tools/validate_cost_model.py-13-      'name:disasm.txt:measured' ...
tools/validate_cost_model.py-14-"""
tools/validate_cost_model.py-15-
tools/validate_cost_model.py-16-import json
tools/validate_cost_model.py-17-import sys
tools/validate_cost_model.py-18-
tools/validate_cost_model.py-19-from optimizer.analysis.critical_path import estimate_critical_path, \
tools/validate_cost_model.py-20-    parse_inst
tools/validate_cost_model.py-21-
tools/validate_cost_model.py-22-
tools/validate_cost_model.py-23-def spearman(xs, ys):
tools/validate_cost_model.py-24-    def rank(v):
tools/validate_cost_model.py:25:        order = sorted(range(len(v)), key=lambda i: v[i])
tools/validate_cost_model.py-26-        r = [0] * len(v)
tools/validate_cost_model.py:27:        for i, idx in enumerate(order):
tools/validate_cost_model.py-28-            r[idx] = i
tools/validate_cost_model.py-29-        return r
tools/validate_cost_model.py-30-    rx, ry = rank(xs), rank(ys)
tools/validate_cost_model.py-31-    n = len(xs)
tools/validate_cost_model.py-32-    if n < 2:
tools/validate_cost_model.py-33-        return 1.0
tools/validate_cost_model.py-34-    d2 = sum((a - b) ** 2 for a, b in zip(rx, ry))
tools/validate_cost_model.py-35-    return 1.0 - 6.0 * d2 / (n * (n * n - 1))
