    29	    "shl": 1, "sshr": 1, "ushr": 1, "asr": 1, "lsl": 1,
    30	    "ld1": 4, "ld2": 4, "ld3": 4, "ld4": 4, "ldr": 4, "ldp": 4,
    31	    "ldur": 4, "ld1r": 4,
    32	    "st1": 1, "st2": 1, "st3": 1, "st4": 1, "str": 1, "stp": 1,
    33	    "stur": 1,
    34	    "cbz": 0, "cbnz": 0, "b": 0, "b.ne": 0, "b.eq": 0, "b.hi": 0,
