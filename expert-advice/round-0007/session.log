    48	
    49	def parse_inst(line):
    50	    """Return (mnemonic, dst, reads) or None."""
    51	    m = re.match(r"\s*[0-9a-f]+:\s+[0-9a-f]{8}\s+([a-z0-9]+)\s*(.*)", line)
    52	    if not m:
    53	        return None
    54	    mn, rest = m.group(1), m.group(2)
    55	    reads = []
    56	    dst = None
    57	
    58	    # memory brackets: stack slots become pseudo-registers (sp#offset)
    59	    for bm in re.finditer(r"\[([^\]]+)\]", rest):
    60	        spm = re.match(r"sp\s*,\s*#(-?\d+)", bm.group(1).strip())
    61	        if spm:
    62	            slot = "sp#%d" % int(spm.group(1))
    63	            if mn in LOAD_MN:
    64	                reads.append(slot)
    65	            elif mn in STORE_MN:
    66	                dst = slot
    67	
    68	    regs = []
    69	    cleaned = re.sub(r"\[[^\]]*\]", "", rest)
    70	    parts = [p.strip() for p in cleaned.split(",") if p.strip()]
    71	    for p in parts:
    72	        for r in REG.findall(p):
    73	            regs.append(r)
    74	    if not regs:
    75	        return mn, dst, reads
    76	
    77	    first = regs[0]
    78	    if mn in NO_DST_MN:
    79	        reads.extend(regs)
    80	    elif mn in LOAD_MN:
    81	        if dst is None:
    82	            dst = first
    83	        reads.extend(regs[1:])
    84	    else:
    85	        dst = first
    86	        reads.extend(regs[1:])
    87	
    88	    # remove zero registers
    89	    reads = [r for r in reads if r not in ("xzr", "wzr")]
    90	    return mn, dst, reads
