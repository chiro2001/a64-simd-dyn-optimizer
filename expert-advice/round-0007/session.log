   436	                             " vget_%s_s32(%s));"
   437	                             % (types[dst], cid(dst), lo,
   438	                                cid(node["src"][0]), hi,
   439	                                cid(node["src"][1])))
   440	        elif op == "load":
   441	            types[dst] = DCT8_TYPE_MAP[node["type"]]
   442	            wide = node["type"] == "<8 x i16>"
   443	            if node.get("const_name"):
   444	                fn = "vld1q_s16" if wide else "vld1_s16"
   445	                lines.append("    %s %s = %s(&dct8_g_t8[0][0] + %d);"
   446	                             % (types[dst], cid(dst), fn,
   447	                                node["const_off"] // 2))
