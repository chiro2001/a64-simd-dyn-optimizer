    25	from optimizer.ir.rewrites import (
    26	    mul64_to_shift, tree_to_mla, wide_loads, widen_overflows)
    27	
    28	
    29	def apply_rewrites(ir, names):
    30	    for name in names:
    31	        if name == "widen":
    32	            widen_overflows(ir)
    33	        elif name == "shift64":
    34	            mul64_to_shift(ir)
    35	        elif name == "wide_load":
    36	            wide_loads(ir)
    37	        elif name == "tree_to_mla":
    38	            tree_to_mla(ir)
    39	        elif name == "nop":
    40	            pass
    41	        else:
    42	            raise ValueError("unknown rewrite %r" % name)
    43	    return ir
    44	
    45	
    46	def path_cost(text, weights):
    47	    _, dist, lines, preds = estimate_critical_path(text)
    48	    i = max(range(len(dist)), key=dist.__getitem__)
    49	    cost = 0.0
    50	    while True:
    51	        cost += weights.get(parse_inst(lines[i])[0], 0.0)
    52	        if preds[i]:
    53	            i = max(preds[i], key=dist.__getitem__)
    54	        else:
    55	            break
    56	    return cost
    57	
    58	
    59	def main():
    60	    if len(sys.argv) < 4:
    61	        print(__doc__)
    62	        return 2
    63	    ir_path, machine, outdir = sys.argv[1], sys.argv[2], sys.argv[3]
    64	    rewrites = [a.split("=", 1)[1] for a in sys.argv[4:]
    65	                if a.startswith("--rewrite=")]
    66	    if machine not in ("n1", "920b"):
    67	        print("machine must be n1 or 920b", file=sys.stderr)
    68	        return 2
    69	    fit = json.load(open(
    70	        "experiments/m16-dct8-protoc/fitted-%s.json" % machine))
    71	    weights = dict(zip(fit["mnemonics"], fit["weights"]))
    72	    doc = json.load(open(ir_path))
    73	    os.makedirs(outdir, exist_ok=True)
    74	
    75	    results = []
    76	    combos = [()] + [c for r in range(1, len(rewrites) + 1)
    77	                     for c in combinations(rewrites, r)]
    78	    for combo in combos:
    79	        tag = "-".join(combo) or "baseline"
    80	        ir = MachineIR(function=doc.get("function"),
    81	                       nodes=[dict(n) for n in doc["nodes"]])
    82	        apply_rewrites(ir, combo)
    83	        cpp = emit_dct8_c_intrinsics(ir, func_name="dynopt_search_candidate")
    84	        src = os.path.join(outdir, "%s.cpp" % tag)
