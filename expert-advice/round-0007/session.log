   154	            e.ref(buf.data(), out_ref.data(), stride);
   155	            e.opt(buf.data(), out_opt.data(), stride);
   156	            if (memcmp(out_ref.data(), out_opt.data(),
   157	                       out_elems * sizeof(int16_t)) != 0)
   158	                mismatches++;
   159	        }
   160	        total_mismatches += mismatches;
   161	        if (mismatches)
   162	            sizes_failed++;
