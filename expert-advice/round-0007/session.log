   423	            if key in DCT8_SHUFFLES:
   424	                fn = DCT8_SHUFFLES[key]
   425	                lines.append("    %s %s = %s(%s);"
   426	                             % (types[dst], cid(dst), fn,
   427	                                cid(node["src"][0])))
   428	            elif key in DCT8_TRNS:
   429	                fn = DCT8_TRNS[key]
   430	                lines.append("    %s %s = %s(%s, %s);"
   431	                             % (types[dst], cid(dst), fn,
   432	                                cid(node["src"][0]), cid(node["src"][1])))
   433	            else:
   434	                lo, hi = DCT8_COMBINES[key]
