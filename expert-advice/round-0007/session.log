    80	    elif mn in LOAD_MN:
    81	        if dst is None:
    82	            dst = first
    83	        reads.extend(regs[1:])
    84	    else:
    85	        dst = first
    86	        reads.extend(regs[1:])
    87	
    88	    # remove zero registers
    89	    reads = [r for r in reads if r not in ("xzr", "wzr")]
    90	    return mn, dst, reads
