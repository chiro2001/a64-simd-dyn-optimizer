kernels/sa8d/sve_dispatch.h-1-// Runtime SVE dispatch contract for generated SA8D candidates.
kernels/sa8d/sve_dispatch.h-2-//
kernels/sa8d/sve_dispatch.h-3-// Packed candidates (pack=2, raw, 16x16) require VL >= 256 bits because
kernels/sa8d/sve_dispatch.h:4:// `svwhilelt_b16(0,16)` activates only 8 lanes at VL=128 and the upper-half
kernels/sa8d/sve_dispatch.h-5-// sum silently becomes zero. Production dispatch must therefore gate them on
kernels/sa8d/sve_dispatch.h-6-// the observed vector length, not on the ISA feature alone.
kernels/sa8d/sve_dispatch.h-7-//
kernels/sa8d/sve_dispatch.h-8-// register_candidates() re-evaluates `svcntb()` every call and marks each
kernels/sa8d/sve_dispatch.h-9-// entry registered when the runtime VL (in bytes) is at least min_vl_bytes.
kernels/sa8d/sve_dispatch.h-10-// call() is the only way to invoke a registered entry: it counts calls and
kernels/sa8d/sve_dispatch.h-11-// aborts on an unregistered call so a contract violation cannot masquerade
kernels/sa8d/sve_dispatch.h-12-// as a passed differential run.
--
