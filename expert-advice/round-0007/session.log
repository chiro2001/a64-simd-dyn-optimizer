    99	def widen_overflows(ir, input_range=(-255, 255), constants=None):
   100	    """Range-driven width fix: widen every s16 sub flagged by the analysis."""
   101	    from optimizer.analysis.range import analyze
   102	
   103	    _, risks = analyze(ir, input_range=input_range, constants=constants)
   104	    sub_ids = [r["id"] for r in risks if r["op"] == "sub"]
   105	    if not sub_ids:
   106	        return ir
   107	    return widen_s16_overflow_subs(ir, sub_ids)
