   533	def emit_sve_intrinsics(machine_ir,
   534	                        func_name="dynopt_sa8d_8x8_neon_sve2",
   535	                        active_lanes=8,
   536	                        pack=1,
   537	                        raw=False):
   538	    """SVE2 backend over the same seed MachineIR.
   539	
   540	    pack=1: `active_lanes` active s16 lanes (default 8), single 8x8 tile.
   541	    pack=2: 16 active s16 lanes, two horizontally adjacent 8x8 tiles packed
   542	    into one vector (tile A in lanes 0-7, tile B in lanes 8-15). The
   543	    per-tile reduction tail is duplicated with half-vector predicates and the
   544	    two rounded results are summed, preserving bit-exact per-tile rounding.
   545	
   546	    Permutes use svtbl2 with constant index vectors; the lane offset of the
   547	    upper 8-lane half is derived from the same NEON shuffle mask. Index
   548	    vectors are loaded under the active predicate `pg` (not svptrue), so
   549	    VL=512 never reads past the 16-entry constant arrays.
   550	
   551	    Contract: pack=2 requires VL >= 256 (fixed VL=256 or VLA-minimum).
