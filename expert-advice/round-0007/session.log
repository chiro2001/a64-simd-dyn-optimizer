     1	"""Typed semantic rewrites on MachineIR.
     2	
     3	These are the optimizer's width/overflow fixes: pattern-driven transformations
     4	that preserve the C reference semantics where the imported kernel used a
     5	narrower arithmetic domain.
     6	"""
     7	
     8	
     9	def widen_dct8_pass2_odd(ir):
    10	    """Fix the upstream dct8 s16-wrap bug on pass 2 odd columns.
    11	
    12	    Upstream computes the second-pass O vectors as `vsub_s16` on pass-1
    13	    coefficient values, which wraps when |coef[k] - coef[7-k]| > 32767 (the C
    14	    reference computes in int32). This rewrite:
    15	
    16	      O = sub<s16>(rshrn2(a), rev64(rshrn2(b)))   ->  O = sub<s32>(sext(a'), sext(b'))
    17	      odd = smull<s16>(c, O)                      ->  odd = mul<s32>(sext(c), O)
    18	
    19	    All products stay below 2**31 (89 * 65280 * 4), so the s32 path is exact.
    20	    """
    21	    nodes = ir.nodes
    22	    bydst = {n.get("dst"): n for n in nodes}
    23	    widened = set()
    24	    out = []
    25	
    26	    for n in nodes:
    27	        if n["op"] == "sub" and n.get("type") == "<4 x i16>":
    28	            first = bydst.get(n["src"][0])
    29	            if first and first["op"] == "intrinsic" \
    30	                    and first["intrinsic"] == "rshrn":
    31	                wa = "w_%s_a" % n["dst"]
    32	                wb = "w_%s_b" % n["dst"]
    33	                out.append({"op": "sext", "type": "<4 x i32>",
    34	                            "src": n["src"][0], "dst": wa})
    35	                out.append({"op": "sext", "type": "<4 x i32>",
    36	                            "src": n["src"][1], "dst": wb})
    37	                out.append({"op": "sub", "type": "<4 x i32>",
    38	                            "src": [wa, wb], "dst": n["dst"]})
    39	                widened.add(n["dst"])
    40	                continue
    41	        if n["op"] == "intrinsic" and n["intrinsic"] == "smull" \
    42	                and n["args"][1]["ref"] in widened:
    43	            wc = "w_%s_c" % n["dst"]
    44	            out.append({"op": "sext", "type": "<4 x i32>",
    45	                        "src": n["args"][0]["ref"], "dst": wc})
    46	            out.append({"op": "mul", "type": "<4 x i32>",
    47	                        "src": [wc, n["args"][1]["ref"]], "dst": n["dst"]})
    48	            continue
    49	        out.append(n)
    50	
    51	    for i, n in enumerate(out):
    52	        n["id"] = i
    53	    ir.nodes = out
    54	    return ir
