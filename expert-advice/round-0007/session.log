   511	def _sve_trn_spec(node):
   512	    """Return (intrinsic, element-type) if the shuffle is exactly an SVE
   513	    TRN1/TRN2 at the native element width, else None.
   514	
   515	    The SA8D seed uses exactly six masks (TRN1/TRN2 at i16/i32/i64), each
   516	    repeated four times. SVE TRN applies the same interleave across the
   517	    whole vector, so at VL=256 the low 8-lane halves (two packed tiles) are
   518	    transformed independently with a single instruction and no index vectors.
   519	    """
   520	    vtype = node["type"]
   521	    mask = tuple(node["mask"])
   522	    patterns = {
   523	        ("<8 x i16>", (0, 8, 2, 10, 4, 12, 6, 14)): ("svtrn1_u16", "u16"),
   524	        ("<8 x i16>", (1, 9, 3, 11, 5, 13, 7, 15)): ("svtrn2_u16", "u16"),
   525	        ("<4 x i32>", (0, 4, 2, 6)): ("svtrn1_u32", "u32"),
   526	        ("<4 x i32>", (1, 5, 3, 7)): ("svtrn2_u32", "u32"),
   527	        ("<2 x i64>", (0, 2)): ("svtrn1_u64", "u64"),
   528	        ("<2 x i64>", (1, 3)): ("svtrn2_u64", "u64"),
   529	    }
   530	    return patterns.get((vtype, mask))
