   271	def tree_to_mla(ir):
   272	    """Replace each pass-2 odd-column addp tree with a 4-deep mla chain.
   273	
   274	    After widen_overflows, each odd output column of dct8 is a tree of four
   275	    `<4 x i32>` per-lane multiplies reduced by three vpaddq_s32. This rewrite
   276	    transposes the four O vectors once per 4-row block (vtrn1q/vtrn2q_s32 +
   277	    vcombine_s32) and folds each column into:
   278	
   279	        mulq_n(Oo0, c0); mlaq_n(acc, Oo1, c1); mlaq_n(acc, Oo2, c2);
   280	        mlaq_n(acc, Oo3, c3)
   281	
   282	    matching prototype (b) from m15. The four coefficient rows are read from
   283	    the g_t8 constant loads so the rewrite is pattern-driven rather than
   284	    hardcoding the four odd columns. It is a no-op unless the pass-2 odd
   285	    subtractions were first widened (mul leaves only exist after `widen`).
   286	    """
   287	    from collections import defaultdict
   288	
   289	    nodes = ir.nodes
   290	    bydst = {n.get("dst"): n for n in nodes if n.get("dst")}
   291	    loads = [n for n in nodes
   292	             if n.get("op") == "load" and n.get("const_name")
   293	             and (n["const_off"] // 16) in (1, 3, 5, 7)]
   294	    if not loads:
   295	        return ir
   296	    load_dsts = {l["dst"] for l in loads}
   297	    sexts = [n for n in nodes
   298	             if n.get("op") == "sext" and _src_list(n)[0] in load_dsts]
   299	    sext_dsts = {s["dst"] for s in sexts}
   300	    muls = [n for n in nodes
   301	            if n.get("op") == "mul" and n.get("type") == "<4 x i32>"
   302	            and _src_list(n)[0] in sext_dsts]
   303	    if not muls:
   304	        return ir
   305	    mul_by_dst = {m["dst"]: m for m in muls}
   306	    mul_dsts = set(mul_by_dst)
   307	    rshrn_by_src = {n["args"][0]["ref"]: n for n in nodes
   308	                    if n.get("op") == "intrinsic"
   309	                    and n.get("intrinsic") == "rshrn"}
   310	
   311	    trees = []
   312	    for n in nodes:
   313	        if n.get("op") != "intrinsic" or n.get("intrinsic") != "addp":
   314	            continue
   315	        if n["dst"] not in rshrn_by_src:
   316	            continue
   317	        leaves = _addp_leaves(n["dst"], bydst, mul_dsts)
   318	        if leaves and len(leaves) == 4:
   319	            trees.append(n)
   320	
   321	    def tree_leaves(root):
   322	        return sorted((mul_by_dst[d] for d in
   323	                       _addp_leaves(root["dst"], bydst, mul_dsts)),
   324	                      key=lambda m: m["id"])
   325	
   326	    def tree_load(root):
   327	        sext = bydst[_src_list(tree_leaves(root)[0])[0]]
   328	        return bydst[_src_list(sext)[0]]
   329	
   330	    by_oset = defaultdict(list)
   331	    for t in trees:
   332	        oset = frozenset(_src_list(m)[1] for m in tree_leaves(t))
   333	        by_oset[oset].append(t)
   334	
   335	    plans = {}
   336	    for oset, group in by_oset.items():
   337	        if len(group) != 4:
   338	            continue
   339	        group = sorted(group, key=lambda t: tree_load(t)["const_off"])
   340	        col_loads = [tree_load(t) for t in group]
   341	        if len({l["const_off"] for l in col_loads}) != 4:
   342	            continue
   343	        leaves = [tree_leaves(t) for t in group]
   344	        o = [_src_list(leaves[0][i])[1] for i in range(4)]
   345	        if len(set(o)) != 4:
   346	            continue
   347	        # every column must share the same row order
   348	        if any(_src_list(m)[1] != o[i]
   349	               for col in leaves for i, m in enumerate(col)):
   350	            continue
   351	        # verify pairing: addp(leaf0,leaf1) + addp(leaf2,leaf3) + addp(root)
   352	        ok = True
   353	        removed = set()
   354	        rshrn_dsts = []
   355	        for t, col in zip(group, leaves):
   356	            p01 = p23 = None
   357	            for n in nodes:
   358	                if n.get("op") != "intrinsic" or n.get("intrinsic") != "addp":
   359	                    continue
   360	                refs = {a["ref"] for a in n["args"]}
   361	                if refs == {col[0]["dst"], col[1]["dst"]}:
   362	                    p01 = n
   363	                elif refs == {col[2]["dst"], col[3]["dst"]}:
   364	                    p23 = n
   365	            if not p01 or not p23:
   366	                ok = False
   367	                break
   368	            root = bydst.get(t["dst"])
   369	            if root and not ({p01["dst"], p23["dst"]}
   370	                             == {a["ref"] for a in root["args"]}):
   371	                ok = False
   372	                break
   373	            rshrn_dsts.append(rshrn_by_src[t["dst"]]["dst"])
   374	            removed.update(m["id"] for m in col)
   375	            removed.update(nn["id"] for nn in (p01, p23, t))
   376	            removed.add(rshrn_by_src[t["dst"]]["id"])
   377	        if not ok:
   378	            continue
   379	        tag = "_".join(o)
   380	        pre = []
   381	        trn = []
   382	        for k, (a, b) in enumerate(((o[0], o[1]), (o[2], o[3]))):
   383	            trn.append((a, b, [0, 4, 2, 6]))
   384	            trn.append((a, b, [1, 5, 3, 7]))
   385	        t1, t2, t3, t4 = ["%s_t%d" % (tag, k + 1) for k in range(4)]
   386	        for (a, b, mask), dst in zip(trn, (t1, t2, t3, t4)):
   387	            pre.append({"op": "shuffle", "type": "<4 x i32>",
   388	                        "src": [a, b], "mask": mask, "dst": dst})
   389	        oo = ["%s_oo%d" % (tag, k) for k in range(4)]
   390	        for dst, (a, b), mask in zip(
   391	                oo, ((t1, t3), (t2, t4), (t1, t3), (t2, t4)),
   392	                ([0, 1, 4, 5], [0, 1, 4, 5], [2, 3, 6, 7], [2, 3, 6, 7])):
   393	            pre.append({"op": "shuffle", "type": "<4 x i32>",
   394	                        "src": [a, b], "mask": mask, "dst": dst})
   395	
   396	        chains = []
   397	        for load, rdst in zip(col_loads, rshrn_dsts):
   398	            vals = DCT8_G_T8[load["const_off"] // 16]
   399	            acc = "mla_%s_%d_0" % (tag, load["const_off"])
   400	            chains.append({"op": "mul", "type": "<4 x i32>", "src": [oo[0]],
   401	                           "const_vec": [vals[0]] * 4, "dst": acc})
   402	            for k in range(1, 4):
   403	                nxt = "mla_%s_%d_%d" % (tag, load["const_off"], k)
   404	                chains.append({"op": "mla", "type": "<4 x i32>",
   405	                               "src": [acc, oo[k]],
   406	                               "const_vec": [vals[k]] * 4, "dst": nxt})
   407	                acc = nxt
   408	            chains.append({"op": "intrinsic", "intrinsic": "rshrn",
   409	                           "type": "<4 x i16>",
   410	                           "args": [{"ref": acc}, {"imm": 9}],
   411	                           "src": [acc], "dst": rdst})
   412	        plans[min(m["id"] for m in muls if m["id"] in removed)] = {
   413	            "pre": pre, "chains": chains, "removed": removed,
   414	            "sexts": sexts,
   415	        }
   416	
   417	    if not plans:
   418	        return ir
   419	    all_removed = set()
   420	    for p in plans.values():
   421	        all_removed |= p["removed"]
   422	    users = defaultdict(set)
   423	    for n in nodes:
   424	        for src in _src_list(n):
   425	            users[src].add(n["id"])
   426	    # remove sexts whose only consumers are gone
   427	    for s in sexts:
   428	        if users.get(s["dst"], set()) <= all_removed:
   429	            all_removed.add(s["id"])
   430	
   431	    out = []
   432	    emitted = set()
   433	    for n in nodes:
   434	        if n["id"] in plans and n["id"] not in emitted:
   435	            p = plans[n["id"]]
   436	            out.extend(dict(x) for x in p["pre"])
   437	            out.extend(dict(x) for x in p["chains"])
   438	            emitted.add(n["id"])
   439	            continue
