   250	def _addp_leaves(root_dst, bydst, leaf_dsts):
   251	    stack = [root_dst]
   252	    leaves = set()
   253	    seen = set()
   254	    while stack:
   255	        d = stack.pop()
   256	        if d in seen:
   257	            continue
   258	        seen.add(d)
   259	        node = bydst.get(d)
   260	        if not node:
   261	            return None
   262	        if node.get("op") == "intrinsic" and node.get("intrinsic") == "addp":
   263	            stack.extend(a["ref"] for a in node["args"])
   264	        elif d in leaf_dsts:
   265	            leaves.add(d)
   266	        else:
   267	            return None
   268	    return leaves
