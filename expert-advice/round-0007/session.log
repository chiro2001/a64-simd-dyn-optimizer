   352	        ok = True
   353	        removed = set()
   354	        rshrn_dsts = []
   355	        for t, col in zip(group, leaves):
   356	            p01 = p23 = None
   357	            for n in nodes:
   358	                if n.get("op") != "intrinsic" or n.get("intrinsic") != "addp":
   359	                    continue
   360	                refs = {a["ref"] for a in n["args"]}
     1	"""Codegen from seed MachineIR to C++ NEON intrinsics (roundtrip).
     2	
     3	The emitter is intentionally narrow: it covers exactly the op/intrinsic set
     4	that appears in the SA8D 8x8 seed. Unknown patterns raise ValueError so a
     5	roundtrip can never silently drop semantics.
     6	"""
     7	
     8	import re
     9	
    10	TYPE_MAP = {
    11	    "<8 x i8>": "uint8x8_t",
    12	    "<8 x i16>": "int16x8_t",
    13	    "<4 x i32>": "int32x4_t",
    14	    "<2 x i64>": "int64x2_t",
    15	    "i32": "uint32_t",
    16	}
    17	
    18	
    19	def _resolve_addr(env, node):
    20	    rhs = node["rhs"]
    21	    m = re.match(
    22	        r"getelementptr\s+inbounds\s+i8,\s*ptr\s+%([A-Za-z0-9._]+),\s*"
    23	        r"i64\s+(%[A-Za-z0-9._]+|\d+)", rhs)
    24	    if not m:
    25	        raise ValueError("unsupported addr form: %r" % rhs)
    26	    ptr, off = m.group(1), m.group(2)
    27	    if off.startswith("%"):
    28	        off = env[off[1:]]
    29	        if not isinstance(off, int):
    30	            raise ValueError("non-coefficient offset")
    31	    else:
    32	        off = int(off)
    33	    if ptr in ("pix1", "pix2"):
    34	        return ptr, off
    35	    base, coef = env[ptr]
    36	    return base, coef + off
    37	
    38	
    39	def _shuffle_intrinsic(vtype, mask):
    40	    patterns = {
    41	        "<8 x i16>": {
    42	            "vtrn1q_s16": [0, 8, 2, 10, 4, 12, 6, 14],
    43	            "vtrn2q_s16": [1, 9, 3, 11, 5, 13, 7, 15],
    44	            "vzip1q_s16": [0, 8, 1, 9, 2, 10, 3, 11],
    45	            "vzip2q_s16": [4, 12, 5, 13, 6, 14, 7, 15],
    46	        },
    47	        "<4 x i32>": {
    48	            "vtrn1q_s32": [0, 4, 2, 6],
    49	            "vtrn2q_s32": [1, 5, 3, 7],
    50	            "vzip1q_s32": [0, 4, 1, 5],
    51	            "vzip2q_s32": [2, 6, 3, 7],
    52	        },
    53	        "<2 x i64>": {
    54	            "vtrn1q_s64": [0, 2],
    55	            "vtrn2q_s64": [1, 3],
    56	            "vzip1q_s64": [0, 2],
    57	            "vzip2q_s64": [1, 3],
    58	        },
    59	    }
    60	    if vtype not in patterns:
    61	        raise ValueError("shuffle type %s unsupported" % vtype)
    62	    for name, pat in patterns[vtype].items():
    63	        if mask == pat:
    64	            return name
    65	    raise ValueError("unhandled shuffle mask %r for %s" % (mask, vtype))
    66	
    67	
    68	def _bitcast_intrinsic(src_type, dst_type):
    69	    m = lambda t: re.match(r"<(\d+) x i(\d+)>", t)
    70	    a, b = m(src_type), m(dst_type)
    71	    if not a or not b:
    72	        raise ValueError("bitcast %s -> %s" % (src_type, dst_type))
    73	    return "vreinterpretq_s%d_s%d" % (int(b.group(2)), int(a.group(2)))
    74	
    75	
    76	def _vector_suffix(vtype):
    77	    m = re.match(r"<(\d+) x i(\d+)>", vtype)
    78	    if not m:
    79	        raise ValueError("not a vector type: %r" % vtype)
    80	    return "s%s" % m.group(2)
    81	
