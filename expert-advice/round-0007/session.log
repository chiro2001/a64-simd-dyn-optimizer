    41	REG = re.compile(r"(?<![\w.])([vqzxwsd]\d+)(?:\.\S+)?(?:\[\d+\])?")
    42	STORE_MN = {"st1", "st2", "st3", "st4", "str", "stp", "stur"}
    43	LOAD_MN = {"ld1", "ld2", "ld3", "ld4", "ldr", "ldp", "ldur", "ld1r"}
    44	NO_DST_MN = {"st1", "st2", "st3", "st4", "str", "stp", "stur", "cmp", "tst",
    45	             "cbz", "cbnz", "b", "b.ne", "b.eq", "b.hi", "b.lo", "b.gt",
