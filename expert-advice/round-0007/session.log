    15	def make_ir():
    16	    # pass1 coef values: cA = rshrn(x,2), cB = rshrn(y,2) (s16)
    17	    # pass2 O = sub<s16>(cA, rev64(cB)) -> wraps upstream
    18	    # odd  = smull<s16>(coef_load, O)
    19	    nodes = [
    20	        {"op": "intrinsic", "intrinsic": "rshrn",
    21	         "args": [{"ref": "x"}, {"imm": 2}], "src": ["x"], "dst": "cA"},
    22	        {"op": "intrinsic", "intrinsic": "rshrn",
    23	         "args": [{"ref": "y"}, {"imm": 2}], "src": ["y"], "dst": "cB"},
    24	        {"op": "shuffle", "type": "<4 x i16>", "src": ["cB"],
    25	         "mask": [3, 2, 1, 0], "dst": "cBr"},
    26	        {"op": "load", "type": "<4 x i16>", "ptr": "0", "dst": "coef"},
    27	        {"op": "sub", "type": "<4 x i16>", "src": ["cA", "cBr"], "dst": "O"},
    28	        {"op": "intrinsic", "intrinsic": "smull",
    29	         "args": [{"ref": "coef"}, {"ref": "O"}], "src": ["coef", "O"],
    30	         "dst": "odd"},
    31	    ]
    32	    for i, n in enumerate(nodes):
    33	        n["id"] = i
    34	    return MachineIR(nodes=nodes)
