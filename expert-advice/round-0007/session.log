   181	static int64_t run_batch(dct_fn fn, const Corpus& corpus, int shape,
   182	                         int batch, bool latency, uint64_t* ticksOut)
   183	{
   184	    const uint64_t mask = CORPUS - 1;
   185	    const uint64_t t0 = read_cntvct();
   186	    // four independent destinations break the WAW chain between calls in
   187	    // throughput mode; one zero-initialized buffer in latency mode keeps the
   188	    // empty implementation's dependent chain well-defined
   189	    int16_t out[4][64 * 64];
   190	    memset(out, 0, sizeof(out));
   191	    int64_t checksum = 0;
   192	    if (latency)
   193	    {
   194	        uint64_t sel = 0x9E3779B97F4A7C15ull;
   195	        for (int i = 0; i < batch; i++)
   196	        {
   197	            const size_t idx = (sel + (uint64_t)i) & mask;
   198	            fn(corpus.a((int)idx) + corpus.off((int)idx), out[0], STRIDE);
   199	            // dependent chain for latency mode, without a 64-element sum
   200	            // polluting the per-call cost
   201	            sel = (uint64_t)((uint32_t)out[0][0] * 0x9E3779B9u
   202	                             + (uint32_t)out[0][shape * shape - 1]);
   203	            checksum += out[0][0] + out[0][shape * shape - 1];
   204	        }
   205	    }
   206	    else
   207	    {
   208	        for (int i = 0; i < batch; i++)
   209	        {
   210	            const size_t idx = (uint64_t)i & mask;
   211	            int16_t* dst = out[i & 3];
   212	            fn(corpus.a((int)idx) + corpus.off((int)idx), dst, STRIDE);
   213	            checksum += dst[0] + dst[shape * shape - 1];
   214	        }
   215	    }
   216	    *ticksOut = read_cntvct() - t0;
   217	    return checksum;
   218	}
