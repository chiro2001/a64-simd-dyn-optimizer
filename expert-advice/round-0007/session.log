    39	}
    40	
    41	REG = re.compile(r"(?<![\w.])([vqzxwsd]\d+)(?:\.\S+)?(?:\[\d+\])?")
    42	STORE_MN = {"st1", "st2", "st3", "st4", "str", "stp", "stur"}
    43	LOAD_MN = {"ld1", "ld2", "ld3", "ld4", "ldr", "ldp", "ldur", "ld1r"}
    44	NO_DST_MN = {"st1", "st2", "st3", "st4", "str", "stp", "stur", "cmp", "tst",
    45	             "cbz", "cbnz", "b", "b.ne", "b.eq", "b.hi", "b.lo", "b.gt",
    46	             "b.le", "b.ge", "b.lt", "ret", "nop"}
    47	
    48	
    49	def parse_inst(line):
    50	    """Return (mnemonic, dst, reads) or None."""
    51	    m = re.match(r"\s*[0-9a-f]+:\s+[0-9a-f]{8}\s+([a-z0-9]+)\s*(.*)", line)
    52	    if not m:
    53	        return None
    54	    mn, rest = m.group(1), m.group(2)
    55	    reads = []
    56	    dst = None
    57	
    58	    # memory brackets: stack slots become pseudo-registers (sp#offset)
    59	    for bm in re.finditer(r"\[([^\]]+)\]", rest):
    60	        spm = re.match(r"sp\s*,\s*#(-?\d+)", bm.group(1).strip())
    61	        if spm:
    62	            slot = "sp#%d" % int(spm.group(1))
    63	            if mn in LOAD_MN:
    64	                reads.append(slot)
    65	            elif mn in STORE_MN:
    66	                dst = slot
    67	
    68	    regs = []
    69	    cleaned = re.sub(r"\[[^\]]*\]", "", rest)
    70	    parts = [p.strip() for p in cleaned.split(",") if p.strip()]
    71	    for p in parts:
    72	        for r in REG.findall(p):
    73	            regs.append(r)
    74	    if not regs:
    75	        return mn, dst, reads
    76	
    77	    first = regs[0]
    78	    if mn in NO_DST_MN:
    79	        reads.extend(regs)
    80	    elif mn in LOAD_MN:
    81	        if dst is None:
    82	            dst = first
    83	        reads.extend(regs[1:])
    84	    else:
    85	        dst = first
    86	        reads.extend(regs[1:])
    87	
    88	    # remove zero registers
    89	    reads = [r for r in reads if r not in ("xzr", "wzr")]
    90	    return mn, dst, reads
    91	
    92	
    93	def estimate_critical_path(text, latency_table=None):
    94	    """Return (critical_path, dist, lines, preds) over objdump text."""
    95	    lat = latency_table or MNEMONIC_LATENCY
    96	    insts = []
    97	    lines = []
    98	    for line in text.splitlines():
    99	        p = parse_inst(line)
   100	        if p:
   101	            mn, dst, reads = p
   102	            insts.append((mn, dst, reads, lat.get(mn, 1)))
   103	            lines.append(line)
   104	
   105	    last_writer = {}
   106	    preds = [[] for _ in insts]
   107	    for i, (mn, dst, reads, _) in enumerate(insts):
   108	        for r in reads:
   109	            if r in last_writer:
   110	                preds[i].append(last_writer[r])
   111	        if dst is not None:
   112	            last_writer[dst] = i
   113	
   114	    dist = []
   115	    best = 0.0
   116	    for i, (mn, dst, reads, l) in enumerate(insts):
   117	        d = l + max((dist[p] for p in preds[i]), default=0)
   118	        dist.append(d)
   119	        best = max(best, d)
   120	    return best, dist, lines, preds
   121	
   122	
   123	def load_mnemonic_hist(text):
   124	    hist = defaultdict(int)
   125	    for line in text.splitlines():
   126	        m = re.match(r"\s*[0-9a-f]+:\s+[0-9a-f]{8}\s+([a-z0-9]+)", line)
   127	        if m:
   128	            hist[m.group(1)] += 1
   129	    return dict(hist)

