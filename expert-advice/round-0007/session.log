   240	                    a2["ref"] = lo_by_id.get(a2["ref"], a2["ref"])
   241	                args.append(a2)
   242	            n2["args"] = args
   243	        out.append(n2)
   244	    for i, n in enumerate(out):
   245	        n["id"] = i
   246	    ir.nodes = out
   247	    return ir
