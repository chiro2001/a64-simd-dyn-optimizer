    83	def emit_c_intrinsics(machine_ir, func_name="dynopt_sa8d_8x8_neon_roundtrip"):
    84	    lines = [
    85	        "#include <arm_neon.h>",
    86	        "#include <cstddef>",
    87	        "#include <stdint.h>",
    88	        "",
    89	        "extern \"C\" int %s(const uint8_t* pix1, intptr_t stride_pix1,"
    90	        " const uint8_t* pix2, intptr_t stride_pix2)" % func_name,
    91	        "{",
    92	    ]
    93	    env = {"pix1": ("pix1", 0), "pix2": ("pix2", 0),
    94	           "i_pix1": 1, "i_pix2": 1}
    95	    types = {}
    96	    cname = {}
    97	
    98	    def cid(name):
    99	        if name not in cname:
   100	            cname[name] = "v%d" % len(cname)
   101	        return cname[name]
   102	
   103	    for node in machine_ir.nodes:
   104	        op = node["op"]
   105	        dst = node.get("dst")
   106	        if op == "shl":
   107	            env[dst] = env[node["src"][0]] << node["amt"]
   108	        elif op == "addr":
   109	            env[dst] = _resolve_addr(env, node)
   110	        elif op == "load":
   111	            base, coef = env[node["ptr"]]
   112	            types[dst] = "uint8x8_t"
   113	            stride = "stride_pix1" if base == "pix1" else "stride_pix2"
   114	            lines.append("    %s %s = vld1_u8((const uint8_t*)%s +"
   115	                         " (size_t)(%d) * %s);"
   116	                         % (types[dst], cid(dst), base, coef, stride))
   117	        elif op == "zext":
   118	            src = node["src"]
   119	            types[dst] = "int16x8_t"
   120	            lines.append("    %s %s = vreinterpretq_s16_u16(vmovl_u8(%s));"
   121	                         % (types[dst], cid(dst), cid(src)))
   122	        elif op in ("add", "sub"):
   123	            vtype = node["type"]
   124	            types[dst] = TYPE_MAP[vtype]
   125	            if len(node["src"]) == 2:
   126	                lines.append("    %s %s = v%sq_%s(%s, %s);"
   127	                             % (types[dst], cid(dst), op,
   128	                                _vector_suffix(vtype),
   129	                                cid(node["src"][0]), cid(node["src"][1])))
   130	            else:
   131	                lines.append("    %s %s = %s + %d;"
   132	                             % (types[dst], cid(dst), cid(node["src"][0]),
   133	                                node.get("const", 0)))
   134	        elif op == "shuffle":
   135	            vtype = node["type"]
   136	            types[dst] = TYPE_MAP[vtype]
   137	            intrinsic = _shuffle_intrinsic(vtype, node["mask"])
   138	            lines.append("    %s %s = %s(%s, %s);"
   139	                         % (types[dst], cid(dst), intrinsic,
   140	                            cid(node["src"][0]), cid(node["src"][1])))
   141	        elif op == "bitcast":
   142	            src = node["src"]
   143	            src_type = node.get("src_type")
   144	            dst_type = node["type"]
   145	            types[dst] = TYPE_MAP[dst_type]
   146	            if src_type and src_type != dst_type:
   147	                intrinsic = _bitcast_intrinsic(src_type, dst_type)
   148	                lines.append("    %s %s = %s(%s);"
   149	                             % (types[dst], cid(dst), intrinsic, cid(src)))
   150	            else:
   151	                lines.append("    %s %s = %s;"
   152	                             % (types[dst], cid(dst), cid(src)))
   153	        elif op == "intrinsic":
   154	            name = node["intrinsic"]
   155	            if name == "abs":
   156	                types[dst] = "int16x8_t"
   157	                lines.append("    %s %s = vabsq_s16(%s);"
   158	                             % (types[dst], cid(dst), cid(node["src"][0])))
   159	            elif name == "sabd":
   160	                types[dst] = "int16x8_t"
   161	                lines.append("    %s %s = vabdq_s16(%s, %s);"
   162	                             % (types[dst], cid(dst), cid(node["src"][0]),
   163	                                cid(node["src"][1])))
   164	            elif name == "umax":
   165	                types[dst] = "int16x8_t"
   166	                lines.append("    %s %s = vreinterpretq_s16_u16(vmaxq_u16("
   167	                             "vreinterpretq_u16_s16(%s),"
   168	                             " vreinterpretq_u16_s16(%s)));"
   169	                             % (types[dst], cid(dst), cid(node["src"][0]),
   170	                                cid(node["src"][1])))
   171	            elif name == "uaddlv":
   172	                types[dst] = "uint32_t"
   173	                lines.append("    %s %s = vaddlvq_u16("
   174	                             "vreinterpretq_u16_s16(%s));"
   175	                             % (types[dst], cid(dst), cid(node["src"][0])))
   176	            else:
   177	                raise ValueError("codegen unknown intrinsic %r" % name)
   178	        elif op == "lshr":
   179	            types[dst] = "uint32_t"
   180	            lines.append("    %s %s = %s >> %d;"
   181	                         % (types[dst], cid(dst), cid(node["src"][0]),
   182	                            node["amt"]))
   183	        elif op == "ret":
   184	            lines.append("    return %s;" % cid(node["operand"]))
   185	        else:
   186	            raise ValueError("codegen unsupported op %r" % op)
   187	    lines.append("}")
   188	    return "\n".join(lines) + "\n"
