   191	def _sve_flat_indices(node):
   192	    """Convert a NEON shuffle mask to flat s16-lane tbl2 indices."""
   193	    m = re.match(r"<(\d+) x i(\d+)>", node["type"])
   194	    lanes = int(m.group(1))
   195	    factor = 8 // lanes
   196	    out = []
   197	    for mask_entry in node["mask"]:
   198	        for j in range(factor):
   199	            if mask_entry < lanes:
   200	                out.append(mask_entry * factor + j)
   201	            else:
   202	                out.append(8 + (mask_entry - lanes) * factor + j)
   203	    return out
   204	
   205	
   206	DCT8_TYPE_MAP = {
   207	    "<8 x i16>": "int16x8_t",
   208	    "<4 x i16>": "int16x4_t",
   209	    "<4 x i32>": "int32x4_t",
   210	    "<2 x i64>": "int64x2_t",
   211	    "i64": "int64_t",
   212	    "i32": "int32_t",
   213	    "i16": "int16_t",
   214	}
   215	
   216	DCT8_SHUFFLES = {
   217	    ("<4 x i16>", (3, 2, 1, 0)): "vrev64_s16",
   218	    ("<4 x i32>", (1, 0, 3, 2)): "vrev64q_s32",
   219	}
   220	
   221	DCT8_TRNS = {
   222	    ("<4 x i32>", (0, 4, 2, 6)): "vtrn1q_s32",
   223	    ("<4 x i32>", (1, 5, 3, 7)): "vtrn2q_s32",
   224	}
   225	
   226	# concat(a[0:2], b[0:2]) / concat(a[2:4], b[2:4]) -- the mask [0,1,4,5] is
   227	# the 64-bit lane interleave that the source wrote as vzip1q_s64 (NOT the
   228	# 32-bit vzip1q_s32 lane order).
   229	DCT8_COMBINES = {
   230	    ("<4 x i32>", (0, 1, 4, 5)): ("low", "low"),
   231	    ("<4 x i32>", (2, 3, 6, 7)): ("high", "high"),
   232	}
   233	
   234	# g_t8 copied from x265 common/constants.cpp at pinned commit b81f650; the
   235	# DCT8 seed loads rows 1/3/5/7 as multiply constants. Kept verbatim so the
   236	# roundtrip stays bit-exact with the C oracle.
   237	G_T8_ROWS = (
   238	    "    { 64, 64, 64, 64, 64, 64, 64, 64 },",
   239	    "    { 89, 75, 50, 18, -18, -50, -75, -89 },",
   240	    "    { 83, 36, -36, -83, -83, -36, 36, 83 },",
   241	    "    { 75, -18, -89, -50, 50, 89, 18, -75 },",
   242	    "    { 64, -64, -64, 64, 64, -64, -64, 64 },",
   243	    "    { 50, -89, 18, 75, -75, -18, 89, -50 },",
   244	    "    { 36, -83, 83, -36, -36, 83, -83, 36 },",
   245	    "    { 18, -50, 75, -89, 89, -75, 50, -18 },",
   246	)
