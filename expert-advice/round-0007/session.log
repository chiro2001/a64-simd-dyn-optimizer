   130	    def _seed(self):
   131	        seed = os.path.join(
   132	            os.path.dirname(__file__), "..", "..", "experiments",
   133	            "m12-dct8", "imported", "machine-ir.json")
   134	        doc = json.load(open(seed))
   135	        return MachineIR(function=doc.get("function"),
   136	                         nodes=[dict(n) for n in doc["nodes"]])
   137	
   138	    def test_noop_without_widen(self):
   139	        ir = self._seed()
   140	        before = ir.to_dict()
   141	        tree_to_mla(ir)
   142	        self.assertEqual(ir.to_dict(), before)
   143	
   144	    def test_rewrites_widened_odd_trees_on_seed(self):
   145	        ir = self._seed()
   146	        widen_overflows(ir)
   147	        tree_to_mla(ir)
   148	        mla = [n for n in ir.nodes if n["op"] == "mla"]
   149	        self.assertEqual(len(mla), 24)          # 2 row groups x 4 cols x 3
   150	        chain_muls = [n for n in ir.nodes if n["op"] == "mul"
   151	                      and n["dst"].startswith("mla_")]
   152	        self.assertEqual(len(chain_muls), 8)    # 2 groups x 4 columns
   153	        trn = [n for n in ir.nodes if n["op"] == "shuffle"
   154	               and tuple(n["mask"]) in ((0, 4, 2, 6), (1, 5, 3, 7))]
   155	        self.assertEqual(len(trn), 8)           # 2 groups x 4 trn ops
   156	        # the pass-1 smull trees must survive untouched
   157	        self.assertEqual(sum(1 for n in ir.nodes
   158	                             if n.get("intrinsic") == "smull"), 32)
   159	
   160	    def test_seed_codegen_after_structural_rewrites(self):
   161	        from optimizer.ir.codegen import emit_dct8_c_intrinsics
   162	
   163	        ir = self._seed()
