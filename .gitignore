# build artifacts
/build/
/third_party/x265/build*/
*.o
*.obj
*.a
*.so
*.so.*

# layout-search generated artifacts (keep results + generated sources only)
experiments/m30-dct16-search/layout-search/*
!experiments/m30-dct16-search/layout-search/results.json
experiments/m30-*-search/layout-search*/
!experiments/m30-*-search/layout-search*/
experiments/m30-*-search/layout-search*/*
!experiments/m30-*-search/layout-search*/results.json
experiments/m30-*-search/*.log
experiments/m30-*-search/store-axis*/
!experiments/m30-*-search/store-axis*/
experiments/m30-*-search/store-axis*/*
!experiments/m30-*-search/store-axis*/results.json
config-temp/
config.log

# python
__pycache__/
*.pyc
.venv/

# tooling
.cache/
.clangd/
compile_commands.json

# crash dumps
*.core
qemu_*.core

# editor
.vscode/
.idea/
*.swp
*.swo

# large local experiment noise (raw samples are committed under experiments/)
*.perf.data
*.perf.data.old

# large regenerable corpus/intermediate oracle outputs (summaries are committed)
experiments/**/corpus-*.bin
experiments/**/oracle-*.txt
experiments/**/llvm-ir/pixel-prim.ll

# regenerable raw LLVM seed modules / unroll intermediates / lift-search
# candidates: recipes (seeds/*.yaml), imported machine-ir.json and result
# summaries are the durable artifacts; the raw modules are recreated by
# tools/extract_seed.py on demand (631MB of untracked modules observed).
experiments/**/llvm-ir/*.ll
experiments/**/llvm-ir/*.ll.*
experiments/**/lift-search/
expert-advice/*/session.log
build/resource-monitor*.log

# vertical-fir sliding=3 search artifacts (2026-08-15): keep durable
# results + best generated source; trace/log/verify/binaries regenerate.
experiments/m30-interp8vpp-search/gen-search3-*/*
!experiments/m30-interp8vpp-search/gen-search3-*/results.json
!experiments/m30-interp8vpp-search/gen-search3-*/sliding-3_acc_split-1.cpp
experiments/m30-interp8vpp-search/gen-search-full-*/*
