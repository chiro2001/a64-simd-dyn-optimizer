+#define DO_DOT_IDX_2B(NAME, TYPED, TYPEN, TYPEM)                        \
+void HELPER(NAME)(void *vd, void *vn, void *vm, void *va, uint32_t desc) \
+{                                                                       \
+    intptr_t seg, j, opr_sz = simd_oprsz(desc);                         \
+    intptr_t index = simd_data(desc);                                   \
+    TYPED *d = vd, *a = va;                                             \
+    TYPEN *n = vn;                                                      \
+    TYPEM *m = vm;                                                      \
+    for (seg = 0; seg < opr_sz; seg += 16) {                            \
+        TYPEM *mp = m + seg / sizeof(TYPEM) + index * 2;                \
+        for (j = 0; j < 16; j += sizeof(TYPED)) {                       \
+            intptr_t i = (seg + j) / sizeof(TYPED);                     \
+            d[i] = a[i] + (TYPED)n[i * 2 + 0] * (TYPED)mp[0] +          \
+                           (TYPED)n[i * 2 + 1] * (TYPED)mp[1];          \
+        }                                                               \
+    }                                                                   \
+    clear_tail(d, opr_sz, simd_maxsz(desc));                            \
+}
+
+DO_DOT_IDX_2B(gvec_sdot_idx_2b, int16_t, int8_t, int8_t)
+DO_DOT_IDX_2B(gvec_udot_idx_2b, uint16_t, uint8_t, uint8_t)
+
+#undef DO_DOT_IDX_2B
+
+#define DO_2WAY_ABAL(NAME, TYPED, TYPEN)                                \
+void HELPER(NAME)(void *vd, void *vn, void *vm, void *va, uint32_t desc) \
+{                                                                       \
+    intptr_t i, n = simd_oprsz(desc) / sizeof(TYPED);                   \
+    TYPED *d = vd, *a = va;                                             \
+    TYPEN *s0 = vn, *s1 = vm;                                           \
+    for (i = 0; i < n; i++) {                                           \
+        TYPED x0 = s0[2 * i + 0], x1 = s0[2 * i + 1];                   \
+        TYPED y0 = s1[2 * i + 0], y1 = s1[2 * i + 1];                   \
+        TYPED d0 = x0 > y0 ? x0 - y0 : y0 - x0;                         \
+        TYPED d1 = x1 > y1 ? x1 - y1 : y1 - x1;                         \
+        d[i] = a[i] + d0 + d1;                                          \
+    }                                                                   \
+    clear_tail(d, n * sizeof(TYPED), simd_maxsz(desc));                 \
+}
+
+DO_2WAY_ABAL(gvec_sabal_h, int16_t, int8_t)
+DO_2WAY_ABAL(gvec_uabal_h, uint16_t, uint8_t)
+DO_2WAY_ABAL(gvec_sabal_s, int32_t, int16_t)
+DO_2WAY_ABAL(gvec_uabal_s, uint32_t, uint16_t)
+DO_2WAY_ABAL(gvec_sabal_d, int64_t, int32_t)
+DO_2WAY_ABAL(gvec_uabal_d, uint64_t, uint32_t)
+
+#undef DO_2WAY_ABAL
+
 #undef DO_DOT
 #undef DO_DOT_IDX
 
